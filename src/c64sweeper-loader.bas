0 REM C64SWEEPER V7 LOADER - HTTPS://M0NDE.ITCH.IO/C64SWEEPER
10 POKE 53280,0:POKE 53281,0
20 IF PEEK(40709)=82 THEN POKE 40709,0:POKE 45,PEEK(174):POKE 46,PEEK(175)
30 REM MEMORY AS HEX64 AND C64DOKU: GAME $4001 (TOP $9000), SCREEN SAVE $2400,
40 REM HELP $2C00, COPY $3400, CHARACTERS $3800, MUSIC $9000, SETTINGS $9F00,
50 REM MENU $C000
60 POKE 55,0:POKE 56,36-108*(PEEK(44)>63):CLR:DV=PEEK(186):IF DV<8 THEN DV=8
70 REM EACH FILE IS KNOWN BY BYTES THAT ONLY THIS VERSION OF THIS GAME HAS
80 N=(PEEK(36872)=77)+(PEEK(16344)=109)+(PEEK(51263)=109)+(PEEK(39442)=110)
90 IF N=-4 THEN 160
100 PRINT CHR$(147);CHR$(142);CHR$(8);CHR$(5);"LOADING C64SWEEPER ..."
110 IF PEEK(36872)<>77 THEN LOAD"C64SWEEPERMUSIC",DV,1
120 IF PEEK(16344)<>109 THEN LOAD"C64SWEEPERCHARS",DV,1
130 IF PEEK(51263)<>109 THEN LOAD"C64SWEEPERBG",DV,1
140 IF PEEK(39442)<>110 THEN LOAD"C64SWEEPERVIEW",DV,1
150 REM HELP AT $2C00, WITH THE BLAST SPRITE ($3440) AND THE ARROWS ($35C0)
160 IF PEEK(11268)<>19 OR PEEK(13344)<>110 THEN LOAD"C64SWEEPERHELP",DV,1
170 PRINT CHR$(142);CHR$(8);:POKE 53272,30:REM CASE FIRST, IT RESETS $D018
180 REM MULTICOLOUR CHARACTERS. THE MENU ALWAYS HAS THE OUTLINE STYLE (BOARD
190 REM STYLE 2, PUT IN BY SYS 51264): SHARED COLOURS MID GREY AND BLUE
200 POKE 780,2:SYS 51264:POKE 53270,PEEK(53270)OR 16:POKE 53282,12:POKE 53283,6
210 VB$="":FOR I=1 TO 5:VB$=VB$+CHR$(188):NEXT:REM 5 EMPTY VOLUME NOTCHES
220 DIM MC%(7),MK%(7),TN$(1):X=RND(-(TI*(PEEK(53266)+TI)))
230 TN$(0)="M{rvon}INES{rvof}":TN$(1)="M{rvon}INES {rvof}C{rvon}ALM{rvof}"
240 IF PEEK(40704)=80 THEN 260
250 GOSUB 970:GOSUB 1030:GOTO 340
260 S2=PEEK(40705):IF S2<>1 THEN S2=0
270 MV=PEEK(40706)-1:EV=PEEK(40707)-1
280 IF MV<0 OR MV>15 THEN MV=9
290 IF EV<0 OR EV>15 THEN EV=9
300 REM BOARD STYLE (40712): BACK TO OUTLINE UNLESS THIS VERSION SET IT (40713 =
310 REM 6), SO A VALUE LEFT BY ANOTHER GAME OR AN OLDER BUILD IS NOT USED
320 IF PEEK(40713)<>6 THEN POKE 40712,3:POKE 40713,6
330 REM TUNE: 0 MINES, 1 MINES CALM (THE DEFAULT)
340 SG=PEEK(40711)-1:IF SG<0 OR SG>1 THEN SG=1
350 POKE 40711,SG+1
360 GOSUB 1050:POKE 36871,SG:POKE 36879,MV:POKE 36870,S2:SYS 36864
370 REM MENU CELLS (CHARACTER, COLOUR): EMPTY, 1, 1, 1, 2, 2, 3, FLAG
380 FOR I=0 TO 7:READ MC%(I),MK%(I):NEXT I
390 DATA 64,6,65,1,65,1,65,1,66,7,66,7,67,2,74,10
400 GOSUB 800
410 REM MAIN LOOP: KEYS; A CELL OPENS OR IS COVERED AGAIN 8 TIMES A SECOND.
420 REM NOW AND THEN A BOMB SHOWS (AT BA) AND GOES OFF: FLASH, SPARKS, GONE
430 GET K$:IF K$<>"" THEN 560
440 IF TI<NT THEN 430
450 NT=TI+8:IF BA THEN 520
460 Y=INT(RND(1)*25):X=INT(RND(1)*40)
470 IF Y>5 AND Y<19 AND X>7 AND X<33 THEN 430:REM NOT IN THE PANEL
480 A=1024+40*Y+X:IF PEEK(A)<>73 THEN POKE A,73:POKE A+54272,14:GOTO 430
490 IF RND(1)<.06 THEN POKE A+54272,15:POKE A,75:BA=A:BT=0:GOTO 430
500 IF RND(1)<.55 THEN N=RND(1)*8:POKE A+54272,MK%(N):POKE A,MC%(N)
510 GOTO 430
520 BT=BT+1:IF BT<3 THEN 430
530 IF BT=3 THEN POKE BA,85:GOTO 430
540 IF BT=4 THEN POKE BA+54272,10:POKE BA,86:GOTO 430
550 POKE BA+54272,6:POKE BA,64:BA=0:GOTO 430
560 IF K$="P" THEN 640
570 IF K$="I" THEN GOSUB 1090:GOSUB 800:GOTO 430
580 IF K$="C" THEN GOSUB 1120:GOSUB 800:GOTO 430
590 IF K$="D" THEN 670
600 IF K$="S" THEN GOSUB 1200:GOSUB 800:GOTO 430
610 IF K$="Q" THEN 700
620 GOTO 430
630 REM PLAY
640 SYS 36867:PRINT "{clr}{wht}L{rvon}OADING {rvof}C64S{rvon}WEEPER {rvof}..."
650 POKE 40709,82:POKE 44,64:POKE 16384,0:LOAD"C64SWEEPERGAME",DV
660 REM THE SELF-PLAYING DEMO
670 SYS 36867:PRINT "{clr}{wht}L{rvon}OADING THE DEMO {rvof}..."
680 POKE 40709,82:POKE 44,64:POKE 16384,0:LOAD"C64SWEEPERDEMO",DV
690 REM QUIT
700 GOSUB 920:R=17:C=10:GOSUB 760:PRINT "{wht}Q{rvon}UIT {rvof}C64S{rvon}WEEPER{rvof}? Y/N";
710 GET K$:IF K$="" THEN 710
720 IF K$<>"Y" THEN GOSUB 920:GOTO 430
730 REM THE MUSIC MARKERS ARE CLEARED SO ANY GAME LOADS ITS OWN MUSIC NEXT TIME
740 SYS 36867:POKE 36864,0:POKE 36872,0:SYS 64738
750 REM SCREEN POSITION, WAIT FOR A KEY
760 POKE 214,R:POKE 211,C:SYS 58732:RETURN
770 GET K$:IF K$="" THEN 770
780 RETURN
790 REM MENU: THE MINEFIELD BACKGROUND (SYS 51200) AND THE PANEL TEXT
800 SYS 51200:BA=0
810 R=8:C=14:GOSUB 760:PRINT "{wht}C64S{rvon}WEEPER {rvof}V7";
820 R=9:C=14:GOSUB 760:PRINT "{cyn}{rvon}M{rvof}0{rvon}NDE{rvof}.{rvon}ITCH{rvof}.{rvon}IO{rvof}";
830 R=11:C=10:GOSUB 760:PRINT "{cyn}P {grn}- {wht}P{rvon}LAY{rvof}";
840 R=12:C=10:GOSUB 760:PRINT "{cyn}I {grn}- {wht}I{rvon}NSTRUCTIONS{rvof}";
850 R=13:C=10:GOSUB 760:PRINT "{cyn}C {grn}- {wht}C{rvon}REDITS{rvof}";
860 R=14:C=10:GOSUB 760:PRINT "{cyn}D {grn}- {wht}D{rvon}EMO{rvof}";
870 N=PEEK(40710):R=15:C=10:GOSUB 760:PRINT "{cyn}S {grn}- {wht}SID {rvon}SETUP{rvof} (";
880 PRINT MID$(STR$(N),2);LEFT$(" SIDS",4-(N>1));")";
890 R=16:C=10:GOSUB 760:PRINT "{cyn}Q {grn}- {wht}Q{rvon}UIT{rvof}";
900 GOSUB 920:RETURN
910 REM FOOTER: PAL OR NTSC, AND THE TUNE
920 R=17:C=9:GOSUB 760:PRINT "                       ";
930 C=9+INT((12+PEEK(678)-5*SG)/2):GOSUB 760
940 PRINT "{grn}";MID$("NTSC PAL",1+5*PEEK(678),4);
950 PRINT "  ";TN$(SG);:RETURN
960 REM SID DETECTION (A SECOND SID AT $D420) AND VOLUME SETUP
970 SYS 36867:POKE 54290,8:POKE 54318,0:POKE 54319,1:POKE 54322,33
980 U=PEEK(54331):T=0:FOR I=1 TO 20:T=T+PEEK(54299):NEXT
990 S2=-(T=0 AND PEEK(54331)<>U)
1000 POKE 54322,0:POKE 54290,0:POKE 40705,S2:POKE 40710,S2+1
1010 POKE 40704,80:POKE 40708,0:RETURN
1020 REM START: MUSIC 2/5, SOUND FX 5/5 WITH TWO SIDS; ONE SID 3/5
1030 MV=6:EV=15:IF S2=0 THEN MV=9:EV=9
1040 POKE 40706,MV+1:POKE 40707,EV+1:RETURN
1050 IF S2=0 THEN EV=MV
1060 POKE 54296,MV:IF S2 THEN POKE 54328,EV
1070 POKE 40706,MV+1:POKE 40707,EV+1:RETURN
1080 REM INSTRUCTIONS: THE HELP SCREEN AT $2C00, COPIED IN BY SYS 13312
1090 POKE 780,44:POKE 782,4:SYS 13312:POKE 780,48:POKE 782,216:SYS 13312
1100 POKE 198,0:GOSUB 770:RETURN
1110 REM CREDITS
1120 PRINT "{clr}{wht}C64S{rvon}WEEPER {rvof}V7":PRINT
1130 PRINT "{wht}D{rvon}ESIGN{rvof}, {rvon}CODE AND GRAPHICS BY M{rvof}0{rvon}NDE{rvof}":PRINT
1140 PRINT "{grn}M{rvon}USIC{rvof}: {wht}M{rvon}INES AND {rvof}M{rvon}INES {rvof}C{rvon}ALM{rvof}"
1150 PRINT "{rvon}BY M{rvof}0{rvon}NDE{rvof}":PRINT
1160 PRINT "{cyn}{rvon}HTTPS{rvof}://{rvon}M{rvof}0{rvon}NDE{rvof}.{rvon}ITCH{rvof}.{rvon}IO{rvof}/{rvon}C{rvof}64{rvon}SWEEPER{rvof}":PRINT
1170 PRINT "{cyn}(C)2026 {rvon}M{rvof}0{rvon}NDE {rvof}- CC BY-NC-SA 4.0":PRINT:PRINT
1180 PRINT "{wht}P{rvon}RESS ANY KEY{rvof}";:GOSUB 770:RETURN
1190 REM SID SETUP
1200 PRINT "{clr}{wht}SID {rvon}SETUP{rvof}":PRINT
1210 N=PEEK(40710):PRINT "{grn}F{rvon}OUND{rvof}: {wht}";MID$(STR$(N),2);LEFT$(" SIDS",4-(N>1))
1220 PRINT "{cyn}  $D400";LEFT$("  $D420",-7*(N=2)):PRINT
1230 O=PEEK(40708):FOR I=0 TO 2:PRINT "{cyn}";MID$(" >",1-(I=O),1);
1240 PRINT "{grn}";MID$(STR$(I+1),2);" ";
1250 M$="A{rvon}UTO DETECT{rvof}":IF I=1 THEN M$="O{rvon}NE {rvof}SID"
1260 IF I=2 THEN M$="T{rvon}WO {rvof}SID{rvon}S{rvof}"
1270 PRINT "{wht}";M$
1280 NEXT:PRINT
1290 PRINT "{grn}T{rvon}WO {rvof}SID{rvon}S{rvof}: {cyn}{rvon}MUSIC{rvof} $D400, FX $D420":PRINT
1300 IF S2 THEN PRINT "{grn}M {cyn}- {wht}M{rvon}USIC VOLUME  {rvof}";
1310 IF S2 THEN PRINT "{grn}E {cyn}- {wht}S{rvon}OUND{rvof} FX"
1320 IF S2=0 THEN PRINT "{grn}V {cyn}- {wht}V{rvon}OLUME{rvof}"
1330 PRINT "{grn}T {cyn}- {wht}T{rvon}UNE{rvof}: ";TN$(SG)
1340 PRINT "{grn}RETURN {cyn}- {wht}B{rvon}ACK{rvof}"
1350 GET K$:IF K$="" THEN 1350
1360 IF K$=CHR$(13) THEN RETURN
1370 IF K$>="1" AND K$<="3" THEN 1410
1380 IF K$="T" THEN SG=1-SG:POKE 40711,SG+1:SYS 36867:GOTO 1450
1390 IF K$="M" OR K$="E" OR K$="V" THEN GOSUB 1470
1400 GOTO 1350
1410 O=VAL(K$)-1:POKE 40708,O:IF O=0 THEN GOSUB 970:POKE 40708,0
1420 IF O=1 THEN S2=0
1430 IF O=2 THEN S2=1
1440 SYS 36867:POKE 40705,S2:POKE 40710,S2+1:GOSUB 1050
1450 POKE 36871,SG:POKE 36879,MV:POKE 36870,S2:SYS 36864:GOTO 1200
1460 REM VOLUME KEYS: M / E WITH TWO SIDS, V WITH ONE
1470 IF S2=0 AND K$<>"V" THEN RETURN
1480 IF S2 AND K$="V" THEN RETURN
1490 IF K$="M" THEN MV=(MV+3)*-(MV<15):POKE 54296,MV:POKE 36879,MV
1500 IF K$="M" THEN POKE 40706,MV+1
1510 IF K$="E" THEN EV=(EV+3)*-(EV<15):POKE 54328,EV:POKE 40707,EV+1
1520 IF K$="V" THEN MV=(MV+3)*-(MV<15):EV=MV:POKE 54296,MV:POKE 36879,MV
1530 IF K$="V" THEN POKE 40706,MV+1:POKE 40707,EV+1
1540 R=20:C=0:GOSUB 760:X=MV:N$="M{rvon}USIC   {rvof}"
1550 IF K$="E" THEN X=EV:N$="S{rvon}OUND{rvof} FX"
1560 IF K$="V" THEN N$="V{rvon}OLUME  {rvof}"
1570 X=INT(X/3+.5):PRINT "{wht}";N$;" ";
1580 PRINT CHR$(18);LEFT$("]]]]]",X);CHR$(146);LEFT$(VB$,5-X);" ";:RETURN
