0 REM C64SWEEPER V5 LOADER - HTTPS://M0NDE.ITCH.IO/C64SWEEPER
10 POKE 53280,0:POKE 53281,0
20 IF PEEK(40709)=82 THEN POKE 40709,0:POKE 45,PEEK(174):POKE 46,PEEK(175)
30 REM MEMORY AS HEX64 AND C64DOKU: GAME $4001 (TOP $9000), SCREEN SAVE $2400,
40 REM HELP $2C00, COPY $3400, CHARACTERS $3800, MUSIC $9000, SETTINGS $9F00,
50 REM MENU $C000
60 POKE 55,0:POKE 56,36-108*(PEEK(44)>63):CLR:DV=PEEK(186):IF DV<8 THEN DV=8
70 REM EACH FILE IS KNOWN BY BYTES THAT ONLY THIS VERSION OF THIS GAME HAS
80 N=(PEEK(36872)=77)+(PEEK(16344)=109)+(PEEK(51263)=109)+(PEEK(50176)=14)
90 IF N=-4 THEN 150
100 PRINT CHR$(147);CHR$(142);CHR$(8);CHR$(5);"LOADING C64SWEEPER ..."
110 IF PEEK(36872)<>77 THEN LOAD"C64SWEEPERMUSIC",DV,1
120 IF PEEK(16344)<>109 THEN LOAD"C64SWEEPERCHARS",DV,1
130 IF PEEK(51263)<>109 THEN LOAD"C64SWEEPERBG",DV,1
140 REM HELP AT $2C00, WITH THE BLAST SPRITE ($3440)
150 IF PEEK(11268)<>19 OR PEEK(13344)<>109 THEN LOAD"C64SWEEPERHELP",DV,1
160 PRINT CHR$(142);CHR$(8);:POKE 53272,30:REM CASE FIRST, IT RESETS $D018
170 REM MULTICOLOUR CHARACTERS. THE MENU ALWAYS HAS THE OUTLINE STYLE (BOARD
180 REM STYLE 2, PUT IN BY SYS 51264): SHARED COLOURS MID GREY AND BLUE
190 POKE 780,2:SYS 51264:POKE 53270,PEEK(53270)OR 16:POKE 53282,12:POKE 53283,6
200 VB$="":FOR I=1 TO 5:VB$=VB$+CHR$(188):NEXT:REM 5 EMPTY VOLUME NOTCHES
210 DIM MC%(7),MK%(7),TN$(1):X=RND(-(TI*(PEEK(53266)+TI)))
220 TN$(0)="M{rvon}INES{rvof}":TN$(1)="M{rvon}INES {rvof}C{rvon}ALM{rvof}"
230 IF PEEK(40704)=80 THEN 250
240 GOSUB 880:GOSUB 940:GOTO 300
250 S2=PEEK(40705):IF S2<>1 THEN S2=0
260 MV=PEEK(40706)-1:EV=PEEK(40707)-1
270 IF MV<0 OR MV>15 THEN MV=9
280 IF EV<0 OR EV>15 THEN EV=9
290 REM TUNE: 0 MINES, 1 MINES CALM (THE DEFAULT)
300 SG=PEEK(40711)-1:IF SG<0 OR SG>1 THEN SG=1
310 POKE 40711,SG+1
320 GOSUB 960:POKE 36871,SG:POKE 36879,MV:POKE 36870,S2:SYS 36864
330 REM MENU CELLS (CHARACTER, COLOUR): EMPTY, 1, 1, 1, 2, 2, 3, FLAG
340 FOR I=0 TO 7:READ MC%(I),MK%(I):NEXT I
350 DATA 64,6,65,1,65,1,65,1,66,7,66,7,67,2,74,10
360 GOSUB 720
370 REM MAIN LOOP: KEYS; A CELL OPENS OR IS COVERED AGAIN 8 TIMES A SECOND.
380 REM NOW AND THEN A BOMB SHOWS (AT BA) AND GOES OFF: FLASH, SPARKS, GONE
390 GET K$:IF K$<>"" THEN 520
400 IF TI<NT THEN 390
410 NT=TI+8:IF BA THEN 480
420 Y=INT(RND(1)*25):X=INT(RND(1)*40)
430 IF Y>5 AND Y<19 AND X>7 AND X<33 THEN 390:REM NOT IN THE PANEL
440 A=1024+40*Y+X:IF PEEK(A)<>73 THEN POKE A,73:POKE A+54272,14:GOTO 390
450 IF RND(1)<.06 THEN POKE A+54272,15:POKE A,75:BA=A:BT=0:GOTO 390
460 IF RND(1)<.55 THEN N=RND(1)*8:POKE A+54272,MK%(N):POKE A,MC%(N)
470 GOTO 390
480 BT=BT+1:IF BT<3 THEN 390
490 IF BT=3 THEN POKE BA,85:GOTO 390
500 IF BT=4 THEN POKE BA+54272,10:POKE BA,86:GOTO 390
510 POKE BA+54272,6:POKE BA,64:BA=0:GOTO 390
520 IF K$="P" THEN 590
530 IF K$="I" THEN GOSUB 1000:GOSUB 720:GOTO 390
540 IF K$="C" THEN GOSUB 1030:GOSUB 720:GOTO 390
550 IF K$="S" THEN GOSUB 1110:GOSUB 720:GOTO 390
560 IF K$="Q" THEN 620
570 GOTO 390
580 REM PLAY
590 SYS 36867:PRINT "{clr}{wht}L{rvon}OADING {rvof}C64S{rvon}WEEPER {rvof}..."
600 POKE 40709,82:POKE 44,64:POKE 16384,0:LOAD"C64SWEEPERGAME",DV
610 REM QUIT
620 GOSUB 830:R=17:C=10:GOSUB 680:PRINT "{wht}Q{rvon}UIT {rvof}C64S{rvon}WEEPER{rvof}? Y/N";
630 GET K$:IF K$="" THEN 630
640 IF K$<>"Y" THEN GOSUB 830:GOTO 390
650 REM THE MUSIC MARKERS ARE CLEARED SO ANY GAME LOADS ITS OWN MUSIC NEXT TIME
660 SYS 36867:POKE 36864,0:POKE 36872,0:SYS 64738
670 REM SCREEN POSITION, WAIT FOR A KEY
680 POKE 214,R:POKE 211,C:SYS 58732:RETURN
690 GET K$:IF K$="" THEN 690
700 RETURN
710 REM MENU: THE MINEFIELD BACKGROUND (SYS 51200) AND THE PANEL TEXT
720 SYS 51200:BA=0
730 R=8:C=14:GOSUB 680:PRINT "{wht}C64S{rvon}WEEPER {rvof}V5";
740 R=9:C=14:GOSUB 680:PRINT "{cyn}{rvon}M{rvof}0{rvon}NDE{rvof}.{rvon}ITCH{rvof}.{rvon}IO{rvof}";
750 R=11:C=10:GOSUB 680:PRINT "{cyn}P {grn}- {wht}P{rvon}LAY{rvof}";
760 R=12:C=10:GOSUB 680:PRINT "{cyn}I {grn}- {wht}I{rvon}NSTRUCTIONS{rvof}";
770 R=13:C=10:GOSUB 680:PRINT "{cyn}C {grn}- {wht}C{rvon}REDITS{rvof}";
780 N=PEEK(40710):R=14:C=10:GOSUB 680:PRINT "{cyn}S {grn}- {wht}SID {rvon}SETUP{rvof} (";
790 PRINT MID$(STR$(N),2);LEFT$(" SIDS",4-(N>1));")";
800 R=15:C=10:GOSUB 680:PRINT "{cyn}Q {grn}- {wht}Q{rvon}UIT{rvof}";
810 GOSUB 830:RETURN
820 REM FOOTER: PAL OR NTSC, AND THE TUNE
830 R=17:C=9:GOSUB 680:PRINT "                       ";
840 C=9+INT((12+PEEK(678)-5*SG)/2):GOSUB 680
850 PRINT "{grn}";MID$("NTSC PAL",1+5*PEEK(678),4);
860 PRINT "  ";TN$(SG);:RETURN
870 REM SID DETECTION (A SECOND SID AT $D420) AND VOLUME SETUP
880 SYS 36867:POKE 54290,8:POKE 54318,0:POKE 54319,1:POKE 54322,33
890 U=PEEK(54331):T=0:FOR I=1 TO 20:T=T+PEEK(54299):NEXT
900 S2=-(T=0 AND PEEK(54331)<>U)
910 POKE 54322,0:POKE 54290,0:POKE 40705,S2:POKE 40710,S2+1
920 POKE 40704,80:POKE 40708,0:RETURN
930 REM START: MUSIC 2/5, SOUND FX 5/5 WITH TWO SIDS; ONE SID 3/5
940 MV=6:EV=15:IF S2=0 THEN MV=9:EV=9
950 POKE 40706,MV+1:POKE 40707,EV+1:RETURN
960 IF S2=0 THEN EV=MV
970 POKE 54296,MV:IF S2 THEN POKE 54328,EV
980 POKE 40706,MV+1:POKE 40707,EV+1:RETURN
990 REM INSTRUCTIONS: THE HELP SCREEN AT $2C00, COPIED IN BY SYS 13312
1000 POKE 780,44:POKE 782,4:SYS 13312:POKE 780,48:POKE 782,216:SYS 13312
1010 POKE 198,0:GOSUB 690:RETURN
1020 REM CREDITS
1030 PRINT "{clr}{wht}C64S{rvon}WEEPER {rvof}V5":PRINT
1040 PRINT "{wht}D{rvon}ESIGN{rvof}, {rvon}CODE AND GRAPHICS BY M{rvof}0{rvon}NDE{rvof}":PRINT
1050 PRINT "{grn}M{rvon}USIC{rvof}: {wht}M{rvon}INES AND {rvof}M{rvon}INES {rvof}C{rvon}ALM{rvof}"
1060 PRINT "{rvon}BY M{rvof}0{rvon}NDE{rvof}":PRINT
1070 PRINT "{cyn}{rvon}HTTPS{rvof}://{rvon}M{rvof}0{rvon}NDE{rvof}.{rvon}ITCH{rvof}.{rvon}IO{rvof}/{rvon}C{rvof}64{rvon}SWEEPER{rvof}":PRINT
1080 PRINT "{cyn}(C)2026 {rvon}M{rvof}0{rvon}NDE {rvof}- CC BY-NC-SA 4.0":PRINT:PRINT
1090 PRINT "{wht}P{rvon}RESS ANY KEY{rvof}";:GOSUB 690:RETURN
1100 REM SID SETUP
1110 PRINT "{clr}{wht}SID {rvon}SETUP{rvof}":PRINT
1120 N=PEEK(40710):PRINT "{grn}F{rvon}OUND{rvof}: {wht}";MID$(STR$(N),2);LEFT$(" SIDS",4-(N>1))
1130 PRINT "{cyn}  $D400";LEFT$("  $D420",-7*(N=2)):PRINT
1140 O=PEEK(40708):FOR I=0 TO 2:PRINT "{cyn}";MID$(" >",1-(I=O),1);
1150 PRINT "{grn}";MID$(STR$(I+1),2);" ";
1160 M$="A{rvon}UTO DETECT{rvof}":IF I=1 THEN M$="O{rvon}NE {rvof}SID"
1170 IF I=2 THEN M$="T{rvon}WO {rvof}SID{rvon}S{rvof}"
1180 PRINT "{wht}";M$
1190 NEXT:PRINT
1200 PRINT "{grn}T{rvon}WO {rvof}SID{rvon}S{rvof}: {cyn}{rvon}MUSIC{rvof} $D400, FX $D420":PRINT
1210 IF S2 THEN PRINT "{grn}M {cyn}- {wht}M{rvon}USIC VOLUME  {rvof}";
1220 IF S2 THEN PRINT "{grn}E {cyn}- {wht}S{rvon}OUND{rvof} FX"
1230 IF S2=0 THEN PRINT "{grn}V {cyn}- {wht}V{rvon}OLUME{rvof}"
1240 PRINT "{grn}T {cyn}- {wht}T{rvon}UNE{rvof}: ";TN$(SG)
1250 PRINT "{grn}RETURN {cyn}- {wht}B{rvon}ACK{rvof}"
1260 GET K$:IF K$="" THEN 1260
1270 IF K$=CHR$(13) THEN RETURN
1280 IF K$>="1" AND K$<="3" THEN 1320
1290 IF K$="T" THEN SG=1-SG:POKE 40711,SG+1:SYS 36867:GOTO 1360
1300 IF K$="M" OR K$="E" OR K$="V" THEN GOSUB 1380
1310 GOTO 1260
1320 O=VAL(K$)-1:POKE 40708,O:IF O=0 THEN GOSUB 880:POKE 40708,0
1330 IF O=1 THEN S2=0
1340 IF O=2 THEN S2=1
1350 SYS 36867:POKE 40705,S2:POKE 40710,S2+1:GOSUB 960
1360 POKE 36871,SG:POKE 36879,MV:POKE 36870,S2:SYS 36864:GOTO 1110
1370 REM VOLUME KEYS: M / E WITH TWO SIDS, V WITH ONE
1380 IF S2=0 AND K$<>"V" THEN RETURN
1390 IF S2 AND K$="V" THEN RETURN
1400 IF K$="M" THEN MV=(MV+3)*-(MV<15):POKE 54296,MV:POKE 36879,MV
1410 IF K$="M" THEN POKE 40706,MV+1
1420 IF K$="E" THEN EV=(EV+3)*-(EV<15):POKE 54328,EV:POKE 40707,EV+1
1430 IF K$="V" THEN MV=(MV+3)*-(MV<15):EV=MV:POKE 54296,MV:POKE 36879,MV
1440 IF K$="V" THEN POKE 40706,MV+1:POKE 40707,EV+1
1450 R=20:C=0:GOSUB 680:X=MV:N$="M{rvon}USIC   {rvof}"
1460 IF K$="E" THEN X=EV:N$="S{rvon}OUND{rvof} FX"
1470 IF K$="V" THEN N$="V{rvon}OLUME  {rvof}"
1480 X=INT(X/3+.5):PRINT "{wht}";N$;" ";
1490 PRINT CHR$(18);LEFT$("]]]]]",X);CHR$(146);LEFT$(VB$,5-X);" ";:RETURN
