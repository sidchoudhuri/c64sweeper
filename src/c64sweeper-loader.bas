0 REM C64SWEEPER V4 LOADER - HTTPS://M0NDE.ITCH.IO/C64SWEEPER
10 POKE 53280,0:POKE 53281,0
20 IF PEEK(40709)=82 THEN POKE 40709,0:POKE 45,PEEK(174):POKE 46,PEEK(175)
30 REM MEMORY AS HEX64 AND C64DOKU: GAME $4001 (TOP $9000), SCREEN SAVE $2400,
40 REM HELP $2C00, COPY $3400, CHARACTERS $3800, MUSIC $9000, SETTINGS $9F00,
50 REM MENU $C000
60 POKE 55,0:POKE 56,36-108*(PEEK(44)>63):CLR:DV=PEEK(186):IF DV<8 THEN DV=8
70 IF PEEK(36872)=77 AND PEEK(14920)=254 AND PEEK(51200)=160 THEN 120
80 PRINT CHR$(147);CHR$(142);CHR$(8);CHR$(5);"LOADING C64SWEEPER ..."
90 IF PEEK(36872)<>77 THEN LOAD"C64SWEEPERMUSIC",DV,1
100 IF PEEK(14920)<>254 THEN LOAD"C64SWEEPERCHARS",DV,1
110 IF PEEK(51200)<>160 THEN LOAD"C64SWEEPERBG",DV,1
120 IF PEEK(11268)<>19 THEN LOAD"C64SWEEPERHELP",DV,1:REM HELP AT $2C00
130 PRINT CHR$(142);CHR$(8);:POKE 53272,30:REM CASE FIRST, IT RESETS $D018
140 VB$="":FOR I=1 TO 5:VB$=VB$+CHR$(188):NEXT:REM 5 EMPTY VOLUME NOTCHES
150 DIM MC%(7),MK%(7),TN$(1):X=RND(-(TI*(PEEK(53266)+TI)))
160 TN$(0)="M{rvon}INES{rvof}":TN$(1)="M{rvon}INES {rvof}C{rvon}ALM{rvof}"
170 IF PEEK(40704)=80 THEN 190
180 GOSUB 750:GOSUB 810:GOTO 240
190 S2=PEEK(40705):IF S2<>1 THEN S2=0
200 MV=PEEK(40706)-1:EV=PEEK(40707)-1
210 IF MV<0 OR MV>15 THEN MV=9
220 IF EV<0 OR EV>15 THEN EV=9
230 REM TUNE: 0 MINES, 1 MINES CALM (THE DEFAULT)
240 SG=PEEK(40711)-1:IF SG<0 OR SG>1 THEN SG=1
250 POKE 40711,SG+1
260 GOSUB 830:POKE 36871,SG:POKE 36879,MV:POKE 36870,S2:SYS 36864
270 REM MENU CELLS (CHARACTER, COLOUR): EMPTY, 1, 1, 1, 2, 2, 3, FLAG
280 FOR I=0 TO 7:READ MC%(I),MK%(I):NEXT I
290 DATA 64,11,65,6,65,6,65,6,66,5,66,5,67,2,74,7
300 GOSUB 590
310 REM MAIN LOOP: KEYS; A CELL OPENS OR IS COVERED AGAIN 8 TIMES A SECOND
320 GET K$:IF K$<>"" THEN 390
330 IF TI<NT THEN 320
340 NT=TI+8:Y=INT(RND(1)*25):X=INT(RND(1)*40)
350 IF Y>5 AND Y<19 AND X>7 AND X<33 THEN 320:REM NOT IN THE PANEL
360 A=1024+40*Y+X:IF PEEK(A)<>73 THEN POKE A,73:POKE A+54272,11:GOTO 320
370 IF RND(1)<.55 THEN N=RND(1)*8:POKE A+54272,MK%(N):POKE A,MC%(N)
380 GOTO 320
390 IF K$="P" THEN 460
400 IF K$="I" THEN GOSUB 870:GOSUB 590:GOTO 320
410 IF K$="C" THEN GOSUB 900:GOSUB 590:GOTO 320
420 IF K$="S" THEN GOSUB 980:GOSUB 590:GOTO 320
430 IF K$="Q" THEN 490
440 GOTO 320
450 REM PLAY
460 SYS 36867:PRINT "{clr}{wht}L{rvon}OADING {rvof}C64S{rvon}WEEPER {rvof}..."
470 POKE 40709,82:POKE 44,64:POKE 16384,0:LOAD"C64SWEEPERGAME",DV
480 REM QUIT
490 GOSUB 700:R=17:C=10:GOSUB 550:PRINT "{wht}Q{rvon}UIT {rvof}C64S{rvon}WEEPER{rvof}? Y/N";
500 GET K$:IF K$="" THEN 500
510 IF K$<>"Y" THEN GOSUB 700:GOTO 320
520 REM THE MUSIC MARKERS ARE CLEARED SO ANY GAME LOADS ITS OWN MUSIC NEXT TIME
530 SYS 36867:POKE 36864,0:POKE 36872,0:SYS 64738
540 REM SCREEN POSITION, WAIT FOR A KEY
550 POKE 214,R:POKE 211,C:SYS 58732:RETURN
560 GET K$:IF K$="" THEN 560
570 RETURN
580 REM MENU: THE MINEFIELD BACKGROUND (SYS 51200) AND THE PANEL TEXT
590 SYS 51200
600 R=8:C=14:GOSUB 550:PRINT "{wht}C64S{rvon}WEEPER {rvof}V4";
610 R=9:C=14:GOSUB 550:PRINT "{cyn}{rvon}M{rvof}0{rvon}NDE{rvof}.{rvon}ITCH{rvof}.{rvon}IO{rvof}";
620 R=11:C=10:GOSUB 550:PRINT "{cyn}P {grn}- {wht}P{rvon}LAY{rvof}";
630 R=12:C=10:GOSUB 550:PRINT "{cyn}I {grn}- {wht}I{rvon}NSTRUCTIONS{rvof}";
640 R=13:C=10:GOSUB 550:PRINT "{cyn}C {grn}- {wht}C{rvon}REDITS{rvof}";
650 N=PEEK(40710):R=14:C=10:GOSUB 550:PRINT "{cyn}S {grn}- {wht}SID {rvon}SETUP{rvof} (";
660 PRINT MID$(STR$(N),2);LEFT$(" SIDS",4-(N>1));")";
670 R=15:C=10:GOSUB 550:PRINT "{cyn}Q {grn}- {wht}Q{rvon}UIT{rvof}";
680 GOSUB 700:RETURN
690 REM FOOTER: PAL OR NTSC, AND THE TUNE
700 R=17:C=9:GOSUB 550:PRINT "                       ";
710 C=9+INT((12+PEEK(678)-5*SG)/2):GOSUB 550
720 PRINT "{grn}";MID$("NTSC PAL",1+5*PEEK(678),4);
730 PRINT "  ";TN$(SG);:RETURN
740 REM SID DETECTION (A SECOND SID AT $D420) AND VOLUME SETUP
750 SYS 36867:POKE 54290,8:POKE 54318,0:POKE 54319,1:POKE 54322,33
760 U=PEEK(54331):T=0:FOR I=1 TO 20:T=T+PEEK(54299):NEXT
770 S2=-(T=0 AND PEEK(54331)<>U)
780 POKE 54322,0:POKE 54290,0:POKE 40705,S2:POKE 40710,S2+1
790 POKE 40704,80:POKE 40708,0:RETURN
800 REM START: MUSIC 2/5, SOUND FX 5/5 WITH TWO SIDS; ONE SID 3/5
810 MV=6:EV=15:IF S2=0 THEN MV=9:EV=9
820 POKE 40706,MV+1:POKE 40707,EV+1:RETURN
830 IF S2=0 THEN EV=MV
840 POKE 54296,MV:IF S2 THEN POKE 54328,EV
850 POKE 40706,MV+1:POKE 40707,EV+1:RETURN
860 REM INSTRUCTIONS: THE HELP SCREEN AT $2C00, COPIED IN BY SYS 13312
870 POKE 780,44:POKE 782,4:SYS 13312:POKE 780,48:POKE 782,216:SYS 13312
880 POKE 198,0:GOSUB 560:RETURN
890 REM CREDITS
900 PRINT "{clr}{wht}C64S{rvon}WEEPER {rvof}V4":PRINT
910 PRINT "{wht}D{rvon}ESIGN{rvof}, {rvon}CODE AND GRAPHICS BY M{rvof}0{rvon}NDE{rvof}":PRINT
920 PRINT "{grn}M{rvon}USIC{rvof}: {wht}M{rvon}INES AND {rvof}M{rvon}INES {rvof}C{rvon}ALM{rvof}"
930 PRINT "{rvon}BY M{rvof}0{rvon}NDE{rvof}":PRINT
940 PRINT "{cyn}{rvon}HTTPS{rvof}://{rvon}M{rvof}0{rvon}NDE{rvof}.{rvon}ITCH{rvof}.{rvon}IO{rvof}/{rvon}C{rvof}64{rvon}SWEEPER{rvof}":PRINT
950 PRINT "{cyn}(C)2026 {rvon}M{rvof}0{rvon}NDE {rvof}- CC BY-NC-SA 4.0":PRINT:PRINT
960 PRINT "{wht}P{rvon}RESS ANY KEY{rvof}";:GOSUB 560:RETURN
970 REM SID SETUP
980 PRINT "{clr}{wht}SID {rvon}SETUP{rvof}":PRINT
990 N=PEEK(40710):PRINT "{grn}F{rvon}OUND{rvof}: {wht}";MID$(STR$(N),2);LEFT$(" SIDS",4-(N>1))
1000 PRINT "{cyn}  $D400";LEFT$("  $D420",-7*(N=2)):PRINT
1010 O=PEEK(40708):FOR I=0 TO 2:PRINT "{cyn}";MID$(" >",1-(I=O),1);
1020 PRINT "{grn}";MID$(STR$(I+1),2);" ";
1030 M$="A{rvon}UTO DETECT{rvof}":IF I=1 THEN M$="O{rvon}NE {rvof}SID"
1040 IF I=2 THEN M$="T{rvon}WO {rvof}SID{rvon}S{rvof}"
1050 PRINT "{wht}";M$
1060 NEXT:PRINT
1070 PRINT "{grn}T{rvon}WO {rvof}SID{rvon}S{rvof}: {cyn}{rvon}MUSIC{rvof} $D400, FX $D420":PRINT
1080 IF S2 THEN PRINT "{grn}M {cyn}- {wht}M{rvon}USIC VOLUME  {rvof}";
1090 IF S2 THEN PRINT "{grn}E {cyn}- {wht}S{rvon}OUND{rvof} FX"
1100 IF S2=0 THEN PRINT "{grn}V {cyn}- {wht}V{rvon}OLUME{rvof}"
1110 PRINT "{grn}T {cyn}- {wht}T{rvon}UNE{rvof}: ";TN$(SG)
1120 PRINT "{grn}RETURN {cyn}- {wht}B{rvon}ACK{rvof}"
1130 GET K$:IF K$="" THEN 1130
1140 IF K$=CHR$(13) THEN RETURN
1150 IF K$>="1" AND K$<="3" THEN 1190
1160 IF K$="T" THEN SG=1-SG:POKE 40711,SG+1:SYS 36867:GOTO 1230
1170 IF K$="M" OR K$="E" OR K$="V" THEN GOSUB 1250
1180 GOTO 1130
1190 O=VAL(K$)-1:POKE 40708,O:IF O=0 THEN GOSUB 750:POKE 40708,0
1200 IF O=1 THEN S2=0
1210 IF O=2 THEN S2=1
1220 SYS 36867:POKE 40705,S2:POKE 40710,S2+1:GOSUB 830
1230 POKE 36871,SG:POKE 36879,MV:POKE 36870,S2:SYS 36864:GOTO 980
1240 REM VOLUME KEYS: M / E WITH TWO SIDS, V WITH ONE
1250 IF S2=0 AND K$<>"V" THEN RETURN
1260 IF S2 AND K$="V" THEN RETURN
1270 IF K$="M" THEN MV=(MV+3)*-(MV<15):POKE 54296,MV:POKE 36879,MV
1280 IF K$="M" THEN POKE 40706,MV+1
1290 IF K$="E" THEN EV=(EV+3)*-(EV<15):POKE 54328,EV:POKE 40707,EV+1
1300 IF K$="V" THEN MV=(MV+3)*-(MV<15):EV=MV:POKE 54296,MV:POKE 36879,MV
1310 IF K$="V" THEN POKE 40706,MV+1:POKE 40707,EV+1
1320 R=20:C=0:GOSUB 550:X=MV:N$="M{rvon}USIC   {rvof}"
1330 IF K$="E" THEN X=EV:N$="S{rvon}OUND{rvof} FX"
1340 IF K$="V" THEN N$="V{rvon}OLUME  {rvof}"
1350 X=INT(X/3+.5):PRINT "{wht}";N$;" ";
1360 PRINT CHR$(18);LEFT$("]]]]]",X);CHR$(146);LEFT$(VB$,5-X);" ";:RETURN
