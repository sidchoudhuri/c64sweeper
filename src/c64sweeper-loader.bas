90 IF PEEK(51200)<>160 THEN LOAD"C64SWEEPERBG",DV,1
100 IF PEEK(11268)<>19 THEN LOAD"C64SWEEPERHELP",DV,1:REM HELP AT $2C00
110 PRINT CHR$(142);CHR$(8);:POKE 53272,30:REM CASE FIRST, IT RESETS $D018
120 VB$="":FOR I=1 TO 5:VB$=VB$+CHR$(188):NEXT:REM 5 EMPTY VOLUME NOTCHES
130 DIM MC%(7),MK%(7):X=RND(-(TI*(PEEK(53266)+TI)))
140 IF PEEK(40704)=80 THEN 160
150 GOSUB 670:GOSUB 730:GOTO 200
160 S2=PEEK(40705):IF S2<>1 THEN S2=0
170 MV=PEEK(40706)-1:EV=PEEK(40707)-1
180 IF MV<0 OR MV>15 THEN MV=9
190 IF EV<0 OR EV>15 THEN EV=9
200 GOSUB 750
210 REM MENU CELLS (CHARACTER, COLOUR): EMPTY, 1, 1, 1, 2, 2, 3, FLAG
220 FOR I=0 TO 7:READ MC%(I),MK%(I):NEXT I
230 DATA 64,11,65,6,65,6,65,6,66,5,66,5,67,2,74,7
240 GOSUB 520
250 REM MAIN LOOP: KEYS; A CELL OPENS OR IS COVERED AGAIN 8 TIMES A SECOND
260 GET K$:IF K$<>"" THEN 330
270 IF TI<NT THEN 260
280 NT=TI+8:Y=INT(RND(1)*25):X=INT(RND(1)*40)
290 IF Y>5 AND Y<19 AND X>7 AND X<33 THEN 260:REM NOT IN THE PANEL
300 A=1024+40*Y+X:IF PEEK(A)<>73 THEN POKE A,73:POKE A+54272,11:GOTO 260
310 IF RND(1)<.55 THEN N=RND(1)*8:POKE A+54272,MK%(N):POKE A,MC%(N)
320 GOTO 260
330 IF K$="P" THEN 400
340 IF K$="I" THEN GOSUB 790:GOSUB 520:GOTO 260
350 IF K$="C" THEN GOSUB 820:GOSUB 520:GOTO 260
360 IF K$="S" THEN GOSUB 880:GOSUB 520:GOTO 260
370 IF K$="Q" THEN 430
380 GOTO 260
390 REM PLAY
400 PRINT "{clr}{wht}L{rvon}OADING {rvof}C64S{rvon}WEEPER {rvof}..."
410 POKE 40709,82:POKE 44,64:POKE 16384,0:LOAD"C64SWEEPERGAME",DV
420 REM QUIT
430 GOSUB 630:R=17:C=10:GOSUB 480:PRINT "{wht}Q{rvon}UIT {rvof}C64S{rvon}WEEPER{rvof}? Y/N";
440 GET K$:IF K$="" THEN 440
450 IF K$<>"Y" THEN GOSUB 630:GOTO 260
460 SYS 64738
470 REM SCREEN POSITION, WAIT FOR A KEY
480 POKE 214,R:POKE 211,C:SYS 58732:RETURN
490 GET K$:IF K$="" THEN 490
500 RETURN
510 REM MENU: THE MINEFIELD BACKGROUND (SYS 51200) AND THE PANEL TEXT
520 SYS 51200
530 R=8:C=14:GOSUB 480:PRINT "{wht}C64S{rvon}WEEPER {rvof}V3";
540 R=9:C=14:GOSUB 480:PRINT "{cyn}{rvon}M{rvof}0{rvon}NDE{rvof}.{rvon}ITCH{rvof}.{rvon}IO{rvof}";
550 R=11:C=10:GOSUB 480:PRINT "{cyn}P {grn}- {wht}P{rvon}LAY{rvof}";
560 R=12:C=10:GOSUB 480:PRINT "{cyn}I {grn}- {wht}I{rvon}NSTRUCTIONS{rvof}";
570 R=13:C=10:GOSUB 480:PRINT "{cyn}C {grn}- {wht}C{rvon}REDITS{rvof}";
580 N=PEEK(40710):R=14:C=10:GOSUB 480:PRINT "{cyn}S {grn}- {wht}SID {rvon}SETUP{rvof} (";
590 PRINT MID$(STR$(N),2);LEFT$(" SIDS",4-(N>1));")";
600 R=15:C=10:GOSUB 480:PRINT "{cyn}Q {grn}- {wht}Q{rvon}UIT{rvof}";
610 GOSUB 630:RETURN
620 REM FOOTER: PAL OR NTSC
630 R=17:C=9:GOSUB 480:PRINT "                       ";
640 C=19+(PEEK(678)=0):GOSUB 480
650 PRINT "{grn}";MID$("NTSC PAL",1+5*PEEK(678),4);:RETURN
660 REM SID DETECTION (A SECOND SID AT $D420)
670 POKE 54290,8:POKE 54318,0:POKE 54319,1:POKE 54322,33
680 U=PEEK(54331):T=0:FOR I=1 TO 20:T=T+PEEK(54299):NEXT
690 S2=-(T=0 AND PEEK(54331)<>U)
700 POKE 54322,0:POKE 54290,0:POKE 40705,S2:POKE 40710,S2+1
710 POKE 40704,80:POKE 40708,0:RETURN
720 REM START VOLUMES AS THE OTHER GAMES: 2/5 AND 5/5 WITH TWO SIDS, ELSE 3/5
730 MV=6:EV=15:IF S2=0 THEN MV=9:EV=9
740 POKE 40706,MV+1:POKE 40707,EV+1:RETURN
750 IF S2=0 THEN EV=MV
760 POKE 54296,MV:IF S2 THEN POKE 54328,EV
770 POKE 40706,MV+1:POKE 40707,EV+1:RETURN
780 REM INSTRUCTIONS: THE HELP SCREEN AT $2C00, COPIED IN BY SYS 13312
790 POKE 780,44:POKE 782,4:SYS 13312:POKE 780,48:POKE 782,216:SYS 13312
800 POKE 198,0:GOSUB 490:RETURN
810 REM CREDITS
820 PRINT "{clr}{wht}C64S{rvon}WEEPER {rvof}V3":PRINT
830 PRINT "{wht}D{rvon}ESIGN{rvof}, {rvon}CODE AND GRAPHICS BY M{rvof}0{rvon}NDE{rvof}":PRINT
840 PRINT "{cyn}{rvon}HTTPS{rvof}://{rvon}M{rvof}0{rvon}NDE{rvof}.{rvon}ITCH{rvof}.{rvon}IO{rvof}/{rvon}C{rvof}64{rvon}SWEEPER{rvof}":PRINT
850 PRINT "{cyn}(C)2026 {rvon}M{rvof}0{rvon}NDE {rvof}- CC BY-NC-SA 4.0":PRINT:PRINT
860 PRINT "{wht}P{rvon}RESS ANY KEY{rvof}";:GOSUB 490:RETURN
870 REM SID SETUP
880 PRINT "{clr}{wht}SID {rvon}SETUP{rvof}":PRINT
890 N=PEEK(40710):PRINT "{grn}F{rvon}OUND{rvof}: {wht}";MID$(STR$(N),2);LEFT$(" SIDS",4-(N>1))
900 PRINT "{cyn}  $D400";LEFT$("  $D420",-7*(N=2)):PRINT
910 O=PEEK(40708):FOR I=0 TO 2:PRINT "{cyn}";MID$(" >",1-(I=O),1);
920 PRINT "{grn}";MID$(STR$(I+1),2);" ";
930 M$="A{rvon}UTO DETECT{rvof}":IF I=1 THEN M$="O{rvon}NE {rvof}SID"
940 IF I=2 THEN M$="T{rvon}WO {rvof}SID{rvon}S{rvof}"
950 PRINT "{wht}";M$
960 NEXT:PRINT
970 PRINT "{grn}T{rvon}WO {rvof}SID{rvon}S{rvof}: {cyn}{rvon}SOUND {rvof}FX {rvon}ON{rvof} $D420":PRINT
980 PRINT "{grn}V {cyn}- {wht}V{rvon}OLUME{rvof}"
990 PRINT "{grn}RETURN {cyn}- {wht}B{rvon}ACK{rvof}"
1000 GET K$:IF K$="" THEN 1000
1010 IF K$=CHR$(13) THEN POKE 54290,0:POKE 54308,0:RETURN
1020 IF K$>="1" AND K$<="3" THEN 1050
1030 IF K$="V" THEN GOSUB 1100
1040 GOTO 1000
1050 O=VAL(K$)-1:POKE 40708,O:IF O=0 THEN GOSUB 670:POKE 40708,0
1060 IF O=1 THEN S2=0
1070 IF O=2 THEN S2=1
1080 POKE 40705,S2:POKE 40710,S2+1:GOSUB 750:GOTO 880
1090 REM V: THE NEXT VOLUME STEP, WITH A BEEP ON THE SOUND FX VOICE
1100 IF S2=0 THEN MV=(MV+3)*-(MV<15):EV=MV:POKE 54296,MV
1110 IF S2 THEN EV=(EV+3)*-(EV<15):POKE 54328,EV
1120 POKE 40706,MV+1:POKE 40707,EV+1
1130 F=54286+18*S2:POKE F,100:POKE F+1,10:POKE F+5,0:POKE F+6,240
1140 POKE F+4,33:POKE F+4,32
1150 R=20:C=0:GOSUB 480:X=INT(EV/3+.5):PRINT "{wht}V{rvon}OLUME{rvof} ";
1160 PRINT CHR$(18);LEFT$("]]]]]",X);CHR$(146);LEFT$(VB$,5-X);" ";:RETURN
