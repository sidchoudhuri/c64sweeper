10 REM **** C64SWEEPER V7 DEMO - THE GAME PLAYS ITSELF ****
20 REM M0NDE.ITCH.IO - HTTPS://GITHUB.COM/SIDCHOUDHURI/C64SWEEPER
30 POKE 45,PEEK(174):POKE 46,PEEK(175):POKE 55,0:POKE 56,144:CLR
40 IF PEEK(40704)<>80 THEN PRINT CHR$(147);"RUN THE LOADER FIRST":END
50 GOTO 2480
60 REM THE BUSIEST ROUTINES COME FIRST: BASIC LOOKS FOR A LINE FROM THE TOP,
70 REM SO A JUMP TO A LOW LINE IS QUICK. LOOPS AVOID GOTO WHERE THEY CAN.
80 REM OPEN CELL J (FLOOD FILL) AND DRAW IT. EVERY 4TH CELL BLIPS (THE RIPPLE)
90 SC%(J)=1:RV=RV+1:K=VL%(J):IF K=0 THEN SK%(SP)=J:SP=SP+1
100 IF K THEN FQ%(NF)=J:NF=NF+1
110 IF (RV AND 3)=0 THEN POKE V2+1,24+(RV AND 31):POKE V2+4,17:POKE V2+4,16
120 REM CELL J SHOWS K: SYS 39424 (C64SWEEPERVIEW) KEEPS IT IN THE MAP AND DRAWS
130 REM IT IF IT IS IN VIEW
140 POKE 780,K:POKE 781,J AND 255:POKE 782,J/256:SYS 39424:RETURN
150 REM FLOOD FILL FROM THE STACK: OPEN CELLS AND FLAGS ARE LEFT ALONE, ONLY
160 REM THE CELLS THAT CHANGE ARE DRAWN
170 IF SP=0 THEN RETURN
180 SP=SP-1:P=SK%(SP):FOR N=0 TO 7:J=P+DO%(N):IF SC%(J)=0 THEN GOSUB 90
190 NEXT N:GOTO 170
200 REM A MINE NEXT TO THE BLAST: THE TILE BLOWS OFF (FLASH, SPARKS), THE BOMB
210 REM SHOWS. SC 3 = SHOWN
220 K=15:GOSUB 140:POKE VF,40+N*3:POKE VG,129:POKE VG,128:K=16:GOSUB 140
230 K=11:SC%(J)=3:GOTO 140
240 REM EVERY OTHER MINE: THE BOMB SHOWS WITH A TICK; ANY KEY HURRIES THE REST
250 K=11:IF QS=0 THEN POKE VF,20+M:POKE VG,129:POKE VG,128:GET K$:GOSUB 3760
260 GOTO 140
270 REM MAIN LOOP
280 GET K$:IF K$<>"" THEN GOSUB 3170
290 IF TI>=AW THEN GOSUB 3270:IF K$<>"" THEN 340
300 IF TI>=FT THEN FT=TI+8:FP=(FP+1)AND 7:POKE 53287,FC%(FP)
310 IF KT THEN IF TI>KT THEN POKE V1+4,0:POKE V2+4,0:POKE V3+4,0:KT=0
320 IF MT THEN IF TI>MT THEN M$="":GOSUB 2140
330 GOTO 280
340 IF K$="W" OR K$=CHR$(145) THEN GOSUB 430:GOTO 280
350 IF K$="S" OR K$=CHR$(17) THEN GOSUB 450:GOTO 280
360 IF K$="A" OR K$=CHR$(157) THEN GOSUB 470:GOTO 280
370 IF K$="D" OR K$=CHR$(29) THEN GOSUB 490:GOTO 280
380 IF K$=" " THEN GOSUB 1350:IF GS THEN 3110
390 IF K$="F" THEN GOSUB 2040:GOTO 280
400 IF K$="Z" THEN GOSUB 680
410 GOTO 280
420 REM MOVING: AT AN EDGE NOTHING MOVES AND THE KEYBOARD BUFFER IS CLEARED
430 IF CY=1 THEN POKE 198,0:RETURN
440 CY=CY-1:I=I-W2:GOTO 520
450 IF CY=H THEN POKE 198,0:RETURN
460 CY=CY+1:I=I+W2:GOTO 520
470 IF CX=1 THEN POKE 198,0:RETURN
480 CX=CX-1:I=I-1:GOTO 520
490 IF CX=W THEN POKE 198,0:RETURN
500 CX=CX+1:I=I+1
510 REM TICK (PULSE), THEN THE CURSOR SPRITE GOES TO CELL CX,CY
520 POKE V1,0:POKE V1+1,35:POKE V1+6,243:POKE V1+4,65:POKE V1+4,64:KT=TI+60
530 IF ZS THEN GOSUB 580
540 POKE 53248,SX%(CX-VX):POKE 53264,SM%(CX-VX)+32:POKE 53249,SY%(CY-VY)
550 POKE 53287,1:POKE 53269,1+AB:FP=2:FT=TI+8:RETURN
560 REM LARGE, ZOOMED IN: THE VIEW MOVES ONE CELL WHEN THE CURSOR COMES WITHIN 2
570 REM CELLS OF ITS EDGE, SO THE CELLS AROUND IT ALWAYS SHOW. SYS 39427 REDRAWS
580 N=VX:P=VY:IF CX-VX<3 AND VX>0 THEN VX=VX-1
590 IF CX-VX>VW-2 AND VX<W-VW THEN VX=VX+1
600 IF CY-VY<3 AND VY>0 THEN VY=VY-1
610 IF CY-VY>VH-2 AND VY<H-VH THEN VY=VY+1
620 IF N=VX AND P=VY THEN RETURN
630 POKE 39436,VX:POKE 39437,VY:SYS 39427
640 REM ARROWS (SPRITES 2-5) WHERE THERE IS MORE BOARD: UP, DOWN, LEFT, RIGHT
650 AB=0:IF ZS THEN AB=-4*(VY>0)-8*(VY<H-VH)-16*(VX>0)-32*(VX<W-VW)
660 POKE 53264,PEEK(53264)OR 32:POKE 53269,(PEEK(53269)AND 3)OR AB:RETURN
670 REM Z (LARGE ONLY): ZOOM OUT TO THE WHOLE BOARD IN SMALL CELLS, OR BACK IN
680 IF SZ<3 THEN POKE 198,0:RETURN
690 ZS=1-ZS:GOSUB 720:GOTO 530
700 REM THE VIEW: SMALL AND MEDIUM SHOW THE WHOLE BOARD IN BIG CELLS; LARGE
710 REM 16X10 BIG CELLS AROUND THE CURSOR (ZOOMED IN) OR ALL OF IT IN SMALL ONES
720 BG=-(SZ<3):IF ZS THEN BG=1
730 CS=1+BG:VW=W:VH=H:VX=0:VY=0:IF ZS=0 THEN 780
740 VW=16:VH=10:VX=CX-8:VY=CY-5:IF VX>W-VW THEN VX=W-VW
750 IF VY>H-VH THEN VY=H-VH
760 IF VX<0 THEN VX=0
770 IF VY<0 THEN VY=0
780 TR=3+INT((20-VH*CS)/2):LC=INT((40-VW*CS)/2):POKE 2040,13+BG
790 POKE 39433,BG:POKE 39434,VW:POKE 39435,VH:POKE 39436,VX:POKE 39437,VY
800 POKE 39438,TR:POKE 39439,LC
810 REM THE CURSOR MOVES TO ITS CELL IN THE NEW VIEW FIRST; THEN THE DRAWING
820 FOR C=1 TO VW:X=23+8*(LC+(C-1)*CS):SM%(C)=-(X>255):SX%(C)=X AND 255:NEXT C
830 FOR R=1 TO VH:SY%(R)=49+8*(TR+(R-1)*CS):NEXT R
840 POKE 53248,SX%(CX-VX):POKE 53264,SM%(CX-VX)+32:POKE 53249,SY%(CY-VY)
850 FOR R=2 TO 23:POKE 214,R:POKE 211,0:SYS 58732:PRINT BL$;:NEXT R
860 REM FRAME (BLUE): ITS LINES SIT THE SAME DISTANCE FROM THE TILES ALL ROUND
870 A=1024+40*(TR-1)+LC-1:P=A+40*(VH*CS+1):N=VW*CS+1
880 FOR C=1 TO N-1:POKE A+C+CM,14:POKE A+C,79:POKE P+C+CM,14:POKE P+C,88:NEXT C
890 POKE A+CM,14:POKE A,78:POKE A+N+CM,14:POKE A+N,80
900 POKE P+CM,14:POKE P,82:POKE P+N+CM,14:POKE P+N,83
910 FOR R=1 TO VH*CS:Q=A+40*R:POKE Q+CM,14:POKE Q,81:POKE Q+N+CM,14:POKE Q+N,89
920 NEXT R:SYS 39427:GOTO 650
930 REM NEW BOARD. BG = 1 FOR BIG CELLS, CS = CELL SIZE IN CHARACTERS
940 PRINT "{clr}";:GOSUB 1140
950 M$="{wht}C{rvon}REATING THE BOARD {rvof}...":GOSUB 2140
960 X=RND(-(SE+BC-12*INT(BC/12)))
970 REM 32 CELLS TO A ROW, SO MACHINE CODE FINDS A CELL'S ROW AND COLUMN
980 REM QUICKLY. LARGE STARTS ZOOMED IN (ZS)
990 W2=32:NC=W*H:ZS=-(SZ=3):AB=0
1000 FOR I=0 TO (H+2)*W2-1:VL%(I)=0:SC%(I)=1:NEXT I
1010 FOR R=1 TO H:FOR C=1 TO W:SC%(R*W2+C)=0:NEXT C,R
1020 POKE 39440,W:POKE 39441,H:SYS 39430
1030 REM THE 8 CELLS AROUND A CELL
1040 DO%(0)=-W2-1:DO%(1)=-W2:DO%(2)=1-W2:DO%(3)=-1
1050 DO%(4)=1:DO%(5)=W2-1:DO%(6)=W2:DO%(7)=W2+1
1060 REM MINES: EACH ONE ADDS 1 TO THE 8 CELLS AROUND IT
1070 FOR K=1 TO MN
1080 P=(INT(RND(1)*H)+1)*W2+INT(RND(1)*W)+1:IF VL%(P)>15 THEN 1080
1090 VL%(P)=VL%(P)+16:ML%(K)=P:FOR N=0 TO 7:J=P+DO%(N):VL%(J)=VL%(J)+1:NEXT N,K
1100 REM FL FLAGS LEFT, RV CELLS OPEN, FR FIRST REVEAL, I THE CURSOR CELL
1110 FL=MN:RV=0:GS=0:FR=1:CX=1:CY=1:I=W2+1:GOSUB 720
1120 M$="":GOSUB 2140:GOSUB 1200:POKE 198,0:GOTO 530
1130 REM HEADER ROWS 0-1
1140 R=0:C=2:GOSUB 2160:PRINT "{wht}C64S{rvon}WEEPER {rvof}V7  {grn}";DN$(SZ);
1150 C=27:GOSUB 2160:PRINT "{grn}M{rvon}INES{rvof}";
1160 REM KEYS: DEMO +/- SPEED Q MENU, CENTRED
1170 R=1:C=6:GOSUB 2160:PRINT "{wht}D{rvon}EMO   {cyn}{rvof}+{grn}/{cyn}- {grn}S{rvon}PEED {wht}{rvof}";
1180 PRINT MID$(STR$(DS),2);"   {cyn}Q {grn}M{rvon}ENU{rvof}";:RETURN
1190 REM FLAGS LEFT
1200 R=0:C=33:GOSUB 2160:PRINT "{wht}";RIGHT$(" "+MID$(STR$(FL),2),2);:RETURN
1210 REM SPRITE 0, THE CURSOR: A 10X10 OUTLINE (BLOCK 13) OR 18X18 FOR BIG CELLS
1220 REM (BLOCK 14). SPRITE 1, THE BLAST: MULTICOLOUR, DOUBLE SIZE (BLOCKS 209+)
1230 FOR I=0 TO 62:POKE 832+I,0:POKE 896+I,0:NEXT I
1240 FOR I=1 TO 8:POKE 832+3*I,128:POKE 833+3*I,64:NEXT I
1250 FOR I=0 TO 1:POKE 832+27*I,255:POKE 833+27*I,192:NEXT I
1260 FOR I=1 TO 16:POKE 896+3*I,128:POKE 898+3*I,64:NEXT I
1270 FOR I=0 TO 1:J=896+51*I:POKE J,255:POKE J+1,255:POKE J+2,192:NEXT I
1280 POKE 53287,14:POKE 53276,2:POKE 53277,2:POKE 53271,2
1290 REM SPRITES 2-5: THE ARROWS AROUND THE ZOOMED-IN VIEW, WHITE
1300 FOR I=0 TO 3:POKE 2042+I,215+I:POKE 53289+I,1:NEXT I
1310 POKE 53252,181:POKE 53253,67:POKE 53254,181:POKE 53255,237
1320 POKE 53256,46:POKE 53257,151:POKE 53258,62:POKE 53259,151:RETURN
1330 REM REVEAL THE CURSOR CELL: THE TILE PRESSES IN, THEN OPENS. THE FIRST
1340 REM REVEAL IS ALWAYS SAFE. THE CLICK (TRIANGLE) RISES WITH THE NUMBER
1350 IF SC%(I) THEN RETURN
1360 IF FR THEN FR=0:IF VL%(I)>15 THEN GOSUB 1450
1370 J=I:K=14:GOSUB 140:IF VL%(I)>15 THEN 1520
1380 V=VL%(I):POKE V2,0:POKE V2+1,20+6*V:POKE V2+6,248:POKE V2+4,17:POKE V2+4,16
1390 KT=TI+60:SC%(I)=1:RV=RV+1:K=V:GOSUB 140:IF V THEN FQ%(NF)=I:NF=NF+1
1400 IF V=0 THEN SP=1:SK%(0)=I:GOSUB 170
1410 IF RV=NC-MN THEN 1890
1420 RETURN
1430 REM THE FIRST REVEAL HIT A MINE: THE MINE MOVES TO A FREE CELL AND ONLY
1440 REM THE COUNTS AROUND THE TWO CELLS CHANGE
1450 J=(INT(RND(1)*H)+1)*W2+INT(RND(1)*W)+1:IF VL%(J)>15 THEN 1450
1460 VL%(I)=VL%(I)-16:VL%(J)=VL%(J)+16:FOR N=0 TO 7:A=I+DO%(N):VL%(A)=VL%(A)-1
1470 A=J+DO%(N):VL%(A)=VL%(A)+1:NEXT N
1480 FOR K=1 TO MN:IF ML%(K)=I THEN ML%(K)=J
1490 NEXT K:RETURN
1500 REM A MINE. MUSIC: WITH ONE SID IT STOPS FOR THE BLAST AND COMES BACK AS
1510 REM MINES; WITH TWO SIDS IT CHANGES TO MINES AND PLAYS ON
1520 GS=1:POKE 53269,0:QS=0
1530 IF S2=0 THEN SYS 36867
1540 IF S2 THEN IF PS THEN POKE 36871,0:SYS 36864:PS=0
1550 REM THE BLAST USES 3 VOICES (ONE SID: THE MUSIC'S TWO AS WELL): B3 A
1560 REM FALLING ROAR (NOISE), B1 A LOW THUMP (TRIANGLE), B2 CRACKLE (NOISE)
1570 B1=54272+32*S2:B2=B1+7:B3=B1+14:K=11:GOSUB 140
1580 X=8*(LC+(CX-1-VX)*CS)+4*CS:Y=29+8*(TR+(CY-1-VY)*CS)+4*CS
1590 POKE 53250,X AND 255:POKE 53251,Y:POKE 53264,2*-(X>255)
1600 POKE B1,0:POKE B2,0:POKE B3,0:POKE B1+5,0:POKE B2+5,0:POKE B3+5,0
1610 POKE B3+6,252:POKE B1+6,249:POKE B2+6,242:POKE B3+4,129:POKE B1+4,17
1620 REM 6 FRAMES: SPRITE PICTURE AND COLOURS, BORDER, SHAKE, SOUND; CRATER AT 3
1630 FOR F=0 TO 5:POKE 2041,209+F:POKE 53285,BF%(F,0):POKE 53286,BF%(F,1)
1640 POKE 53288,BF%(F,2):POKE 53269,2:POKE 53280,BD%(F):POKE 53265,27+SH%(F)
1650 POKE B3+1,60-10*F:POKE B1+1,12-2*F
1660 POKE B2+1,200-RND(1)*100:POKE B2+4,128:POKE B2+4,129
1670 IF F=2 THEN K=12:GOSUB 140
1680 TE=TI+5
1690 IF TI<TE THEN 1690
1700 NEXT F
1710 POKE 53269,0:POKE 53265,27:POKE 53280,0
1720 POKE B3+4,128:POKE B1+4,16:POKE B2+4,128
1730 IF S2=0 THEN POKE 36871,0:SYS 36864:PS=0
1740 REM THE OTHER MINES: THE ONES NEXT TO THE BLAST GO OFF FIRST, THEN THE REST
1750 REM SHOW ONE BY ONE. FLAGGED MINES STAY FLAGS
1760 POKE 198,0:POKE V3,0:POKE V3+6,247:POKE V3+5,0
1770 FOR N=0 TO 7:J=I+DO%(N):IF VL%(J)>15 THEN IF SC%(J)=0 THEN GOSUB 220
1780 NEXT N
1790 FOR M=1 TO MN:J=ML%(M):IF SC%(J)=0 THEN IF J<>I THEN GOSUB 250
1800 NEXT M:KT=TI+150
1810 REM WRONG FLAGS ARE CROSSED OUT
1820 IF FL=MN THEN 1850
1830 FOR J=W2+1 TO H*W2+W:IF SC%(J)=2 THEN IF VL%(J)<16 THEN GOSUB 2020
1840 NEXT J
1850 M$="{wht}B{rvon}OOM{rvof}! {grn}S{rvon}PACE {rvof}- {rvon}PLAY AGAIN  {rvof}Q - {rvon}MENU{rvof}":GOTO 2140
1860 REM ALL CLEAR: A FLAG GOES UP ON EVERY MINE WITH RISING NOTES (NO TILE
1870 REM BEHIND IT, SO THE GREEN SHOWS), A COLOUR WAVE RUNS OVER THE FLAGS
1880 REM (WHITE, YELLOW, GREEN), THEN THE FANFARE (TRIANGLE)
1890 GS=2:POKE 53269,0:N=0:POKE V3,0:POKE V3+6,246
1900 FOR M=1 TO MN:J=ML%(M):GOSUB 1970:NEXT M:FL=0:GOSUB 1200
1910 FOR N=0 TO 2:Z=9:IF N=1 THEN Z=15
1920 IF N=2 THEN Z=13
1930 POKE 39985,Z:K=17:FOR M=1 TO MN:J=ML%(M):GOSUB 140:NEXT M,N
1940 POKE V3,0:POKE V3+6,248
1950 X=20:Y=8:GOSUB 1990:X=30:GOSUB 1990:X=45:Y=16:GOSUB 1990:KT=TI+60
1960 M$="{wht}Y{rvon}OU WIN{rvof}! {grn}S{rvon}PACE {rvof}- {rvon}PLAY AGAIN  {rvof}Q - {rvon}MENU{rvof}":GOTO 2140
1970 K=17:GOSUB 140:POKE V3+1,AR%(N AND 7):POKE V3+4,17:POKE V3+4,16:N=N+1
1980 RETURN
1990 POKE V3+1,X:POKE V3+4,17:TE=TI+Y
2000 IF TI<TE THEN 2000
2010 POKE V3+4,16:RETURN
2020 K=13:GOTO 140
2030 REM FLAG OR UNFLAG THE CURSOR CELL
2040 IF SC%(I)=1 THEN RETURN
2050 J=I:IF SC%(I)=0 THEN 2070
2060 SC%(I)=0:FL=FL+1:K=9:GOSUB 140:GOTO 2090
2070 IF FL=0 THEN RETURN
2080 SC%(I)=2:FL=FL-1:K=10:GOSUB 140
2090 GOSUB 2110:GOTO 1200
2100 REM BEEP (SAWTOOTH)
2110 POKE V2,100:POKE V2+1,10:POKE V2+6,240:POKE V2+4,33:POKE V2+4,32:KT=TI+60
2120 RETURN
2130 REM STATUS LINE (ROW 24): M$, CENTRED
2140 MT=0:GOSUB 2180:R=24:C=0:GOSUB 2160:PRINT BL$;
2150 C=INT((40-N)/2):GOSUB 2160:PRINT M$;:RETURN
2160 POKE 214,R:POKE 211,C:SYS 58732:RETURN
2170 REM N = HOW MANY CHARACTERS OF M$ SHOW (NOT COUNTING CONTROL CODES)
2180 N=0:IF M$="" THEN RETURN
2190 FOR K=1 TO LEN(M$):A=ASC(MID$(M$,K,1))
2200 N=N-((A>31 AND A<128) OR A>159):NEXT K:RETURN
2210 REM BOARD STYLE: SYS 51264 PUTS THE SHAPES OF STYLE SY INTO THE CHARACTER
2220 REM SET, SO EVERY CELL ON THE SCREEN CHANGES AT ONCE. THE SECOND SHARED
2230 REM COLOUR IS LIGHT GREY (CLASSIC) OR BLUE (BLUE, OUTLINE, DASHED)
2240 POKE 780,SY:SYS 51264:POKE 53283,15+9*(SY>0):RETURN
2250 REM B: THE NEXT STYLE, NAMED ON THE STATUS LINE FOR 2 SECONDS
2260 SY=(SY+1)AND 3:GOSUB 2240
2270 M$="{wht}S{rvon}TYLE{rvof}: "+SN$(SY):GOSUB 2140:MT=TI+120:RETURN
2280 REM T: THE OTHER TUNE, NAMED ON THE STATUS LINE FOR 2 SECONDS
2290 SG=1-SG:POKE 40711,SG+1:SYS 36867:POKE 36871,SG:SYS 36864:PS=SG
2300 M$="{wht}M{rvon}USIC{rvof}: "+TN$(SG):GOSUB 2140:MT=TI+120:RETURN
2310 REM VOLUME KEYS: M / E WITH TWO SIDS, V WITH ONE
2320 IF S2=0 AND K$<>"V" THEN RETURN
2330 IF S2 AND K$="V" THEN RETURN
2340 IF K$="M" THEN MV=(MV+3)*-(MV<15):POKE 54296,MV:POKE 36879,MV
2350 IF K$="M" THEN POKE 40706,MV+1
2360 IF K$="E" THEN EV=(EV+3)*-(EV<15):POKE 54328,EV:POKE 40707,EV+1
2370 IF K$="V" THEN MV=(MV+3)*-(MV<15):EV=MV:POKE 54296,MV:POKE 36879,MV
2380 IF K$="V" THEN POKE 40706,MV+1:POKE 40707,EV+1
2390 X=MV:N$="M{rvon}USIC{rvof}":IF K$="E" THEN X=EV:N$="S{rvon}OUND{rvof} FX"
2400 IF K$="V" THEN N$="V{rvon}OLUME{rvof}"
2410 X=INT(X/3+.5):M$="{wht}"+N$+" "+CHR$(18)+LEFT$("]]]]]",X)
2420 M$=M$+CHR$(146)+LEFT$(VB$,5-X)
2430 GOSUB 2140:MT=TI+120:RETURN:REM THE VOLUME BAR GOES AFTER 2 SECONDS
2440 REM BACK TO THE LOADER
2450 SYS 36867:POKE V1+4,0:POKE V2+4,0:POKE V3+4,0:POKE 40709,82:POKE 53269,0
2460 PRINT "{clr}{wht}L{rvon}OADING {rvof}C64S{rvon}WEEPER {rvof}...":LOAD"C64SWEEPER",DV
2470 REM START: TABLES, SETTINGS, SPRITES, MUSIC
2480 REM PROGRAM AT $4001, MEMORY TOP $9000 BELOW THE MUSIC (AS HEX64, C64DOKU)
2490 DV=PEEK(186):IF DV<8 THEN DV=8
2500 REM VL MINES AROUND A CELL (+16 = IT IS A MINE), SC 0 COVERED / 1 OPEN /
2510 REM 2 FLAG, SK FLOOD FILL STACK, ML WHERE THE MINES ARE.
2520 REM THE BOARD HAS A BORDER OF OPEN CELLS, SO NO EDGE CHECKS ARE NEEDED
2530 REM BASIC FINDS A VARIABLE BY LOOKING THROUGH THEM IN THE ORDER THEY WERE
2540 REM MADE, SO THE BUSIEST ONES ARE MADE FIRST. CM = COLOUR RAM - SCREEN
2550 DIM J,K,A,BG,CM,N,P,SP,RV,M,I,V2,V3,V1,VF,VG,KT,MT,FT,FP,CX,CY,W2,QS,K$
2560 DIM ZS,VX,VY,VW,VH,AB,AW,TG,NF,NQ,SS,CC,KP,DD,FX,D,E,S,R,C
2570 DIM X,Y,Z,B,Q:CM=54272
2580 DIM SC%(511),VL%(511),SK%(511),DO%(7)
2590 DIM ML%(60),SX%(24),SM%(24),SY%(14)
2600 DIM FQ%(399),TQ%(399),TK%(399),PL%(511)
2610 DIM FC%(7),DN$(3),BW%(3),BH%(3),BM%(3),TN$(1),SN$(3),BF%(5,2),SH%(5)
2620 DIM BD%(5),AR%(7),DT%(5)
2630 REM WHAT A CELL SHOWS (K): 0 EMPTY, 1-8 NUMBERS, 9 TILE, 10 FLAG, 11 BOMB,
2640 REM 12 CRATER, 13 WRONG FLAG, 14 PRESSED TILE, 15-16 POP, 17 FLAG WHEN YOU
2650 REM WIN; ITS CHARACTERS AND COLOURS ARE IN C64SWEEPERVIEW
2660 PRINT CHR$(147);CHR$(142);CHR$(8);:POKE 53280,0:POKE 53281,0:POKE 53272,30
2670 REM MULTICOLOUR CHARACTERS. STYLE SY: 0 CLASSIC, 1 BLUE, 2 OUTLINE (THE
2680 REM DEFAULT, AS THE MENU), 3 DASHED. THE NAMES ARE PADDED TO THE SAME WIDTH
2690 SY=PEEK(40712)-1:IF SY<0 OR SY>3 THEN SY=2
2700 SN$(0)="C{rvon}LASSIC{rvof}":SN$(1)="B{rvon}LUE{rvof}   ":SN$(2)="O{rvon}UTLINE{rvof}":SN$(3)="D{rvon}ASHED{rvof} "
2710 POKE 53270,PEEK(53270)OR 16:POKE 53282,12:GOSUB 2240
2720 BL$="":FOR I=1 TO 39:BL$=BL$+" ":NEXT I
2730 VB$="":FOR I=1 TO 5:VB$=VB$+CHR$(188):NEXT I:REM 5 EMPTY VOLUME NOTCHES
2740 TN$(0)="M{rvon}INES{rvof}":TN$(1)="M{rvon}INES {rvof}C{rvon}ALM{rvof}"
2750 DN$(1)="S{rvon}MALL{rvof}":DN$(2)="M{rvon}EDIUM{rvof}":DN$(3)="L{rvon}ARGE{rvof}"
2760 REM BOARDS: WIDTH, HEIGHT, MINES. SMALL AND MEDIUM HAVE BIG (2X2) CELLS
2770 FOR I=1 TO 3:READ BW%(I),BH%(I),BM%(I):NEXT I
2780 DATA 8,8,10,16,10,30,24,14,60
2790 REM CURSOR FRAME PULSE: LIGHT BLUE, LIGHT GREY, WHITE, LIGHT GREY
2800 FOR I=0 TO 7:READ FC%(I):NEXT I
2810 DATA 14,15,1,1,1,15,14,14
2820 REM BLAST FRAMES: SPRITE COLOURS ($D025, $D026, SPRITE), SHAKE, BORDER
2830 FOR I=0 TO 5:READ BF%(I,0),BF%(I,1),BF%(I,2),SH%(I),BD%(I):NEXT I
2840 DATA 7,8,1,2,1,7,8,1,-2,7,7,8,1,2,8,7,8,2,-1,2,12,8,2,1,0,12,8,2,0,0
2850 REM NOTES FOR THE FLAGS GOING UP WHEN YOU WIN (D MINOR, RISING)
2860 FOR I=0 TO 7:READ AR%(I):NEXT I
2870 DATA 19,23,25,29,34,39,46,51
2880 S2=PEEK(40705):IF S2<>1 THEN S2=0
2890 MV=PEEK(40706)-1:EV=PEEK(40707)-1:IF MV<0 OR MV>15 THEN MV=9
2900 IF EV<0 OR EV>15 THEN EV=9
2910 REM FX: TWO SIDS, $D420 VOICES 1-3; ONE SID, ALL ON VOICE 3
2920 FS=54272+32*S2:V1=FS:V2=FS+7:V3=FS+14
2930 IF S2=0 THEN EV=MV:V1=54286:V2=V1:V3=V1
2940 POKE 54296,MV:IF S2 THEN POKE 54328,EV
2950 REM PULSE WIDTH AND ATTACK/DECAY NEVER CHANGE, SO THEY ARE SET ONCE
2960 POKE V1+2,0:POKE V1+3,8:POKE V1+5,0:POKE V2+5,0:POKE V3+5,0:VF=V3+1:VG=V3+4
2970 SG=PEEK(40711)-1:IF SG<0 OR SG>1 THEN SG=1:REM 0 MINES, 1 MINES CALM
2980 GOSUB 1230
2990 REM MUSIC. PS = THE TUNE THAT IS PLAYING (A BLAST CHANGES IT TO MINES)
3000 POKE 36871,SG:POKE 36879,MV:POKE 36870,S2:SYS 36864:PS=SG
3010 REM DEMO SPEED 1-5: JIFFIES FOR EACH CURSOR STEP
3020 FOR I=1 TO 5:READ DT%(I):NEXT I
3030 DATA 30,20,12,6,1
3040 DS=3:DL=DT%(DS):SE=1764:BC=0
3050 REM THE NEXT BOARD: THE SAME 12 GAMES EVERY TIME (SEED SE); THE STYLE
3060 REM MOVES ON
3070 SY=BC AND 3:GOSUB 2240:SZ=BC-3*INT(BC/3)+1:W=BW%(SZ):H=BH%(SZ):MN=BM%(SZ)
3080 IF PS<>SG THEN POKE 36871,SG:SYS 36864:PS=SG
3090 BX=-(SZ=2):ZD=0:NF=0:NQ=0:TG=-1:GOSUB 940:BC=BC+1:AW=TI+60:GOTO 280
3100 REM GAME OVER: 3 SECONDS, THEN THE NEXT BOARD
3110 TE=TI+180
3120 GET K$:IF K$<>"" THEN GOSUB 3170
3130 IF KT THEN IF TI>KT THEN POKE V1+4,0:POKE V2+4,0:POKE V3+4,0:KT=0
3140 IF TI<TE THEN 3120
3150 GOTO 3070
3160 REM KEYS IN THE DEMO: Q MENU, + AND - SPEED, VOLUME, TUNE
3170 IF K$="Q" THEN 2450
3180 IF K$="+" THEN IF DS<5 THEN DS=DS+1:GOSUB 3230
3190 IF K$="-" THEN IF DS>1 THEN DS=DS-1:GOSUB 3230
3200 IF K$="M" OR K$="E" OR K$="V" THEN GOSUB 2320
3210 IF K$="T" THEN GOSUB 2290
3220 K$="":RETURN
3230 DL=DT%(DS):R=1:C=23:GOSUB 2160:PRINT "{wht}";MID$(STR$(DS),2);:RETURN
3240 REM THE DEMO'S MOVE: A STEP TOWARDS ITS TARGET CELL TG (AS IF W/A/S/D WAS
3250 REM PRESSED), THEN SPACE OR F THERE (TA$). ON LARGE IT ZOOMS OUT A THIRD OF
3260 REM THE WAY THROUGH AND BACK IN 4 SECONDS LATER
3270 AW=TI+DL:IF ZD=1 THEN IF TI>ZB THEN ZD=2:K$="Z":RETURN
3280 IF SZ=3 THEN IF ZD=0 THEN IF RV*3>NC-MN THEN ZD=1:ZB=TI+240:K$="Z":RETURN
3290 IF TG<0 THEN GOSUB 3390
3300 R=INT(TG/32):C=TG AND 31
3310 IF R<CY THEN K$="W":RETURN
3320 IF R>CY THEN K$="S":RETURN
3330 IF C<CX THEN K$="A":RETURN
3340 IF C>CX THEN K$="D":RETURN
3350 K$=TA$:TG=-1:AW=TI+3*DL:RETURN
3360 REM THE NEXT TARGET. FIRST THE MIDDLE OF THE BOARD; ON MEDIUM, HALF WAY
3370 REM THROUGH, A MINE; OTHERWISE THE NEAREST CELL ON THE LIST (TQ; TK 1 =
3380 REM FLAG)
3390 IF RV=0 THEN TG=INT(H/2+.5)*W2+INT(W/2+.5):TA$=" ":RETURN
3400 IF BX THEN IF RV*2>NC-MN THEN BX=0:GOTO 3700
3410 IF NQ=0 THEN GOSUB 3540
3420 IF NQ=0 THEN 3640
3430 DD=999:E=-1:FOR Q=0 TO NQ-1:A=TQ%(Q):IF SC%(A)=0 THEN GOSUB 3490:GOSUB 3470
3440 NEXT Q:IF E<0 THEN NQ=0:GOTO 3390
3450 TG=TQ%(E):TA$=" ":IF TK%(E) THEN TA$="F"
3460 NQ=NQ-1:TQ%(E)=TQ%(NQ):TK%(E)=TK%(NQ):RETURN
3470 IF D<DD THEN DD=D:E=Q
3480 RETURN
3490 R=INT(A/32):C=A AND 31:D=ABS(R-CY)+ABS(C-CX):RETURN
3500 REM THINK: EACH OPEN NUMBER WITH COVERED CELLS AROUND IT. IF ITS FLAGS
3510 REM ALREADY MAKE THE NUMBER, THE COVERED CELLS ARE SAFE; IF THE FLAGS AND
3520 REM THE COVERED CELLS TOGETHER MAKE IT, THEY ARE ALL MINES. NUMBERS WITH
3530 REM NOTHING COVERED AROUND THEM LEAVE THE LIST
3540 SS=SS+1:KP=0:FOR Q=0 TO NF-1:J=FQ%(Q):CC=0:FX=0
3550 FOR N=0 TO 7:S=SC%(J+DO%(N)):CC=CC-(S=0):FX=FX-(S=2):NEXT N
3560 IF CC THEN FQ%(KP)=J:KP=KP+1:V=VL%(J):IF V=FX OR V=FX+CC THEN GOSUB 3580
3570 NEXT Q:NF=KP:RETURN
3580 B=-(V=FX+CC):FOR N=0 TO 7:A=J+DO%(N):IF SC%(A)=0 THEN GOSUB 3600
3590 NEXT N:RETURN
3600 IF PL%(A)=SS THEN RETURN
3610 PL%(A)=SS:TQ%(NQ)=A:TK%(NQ)=B:NQ=NQ+1:RETURN
3620 REM NOTHING CERTAIN: THE NEAREST SAFE COVERED CELL NEXT TO AN OPEN NUMBER
3630 REM (THE DEMO KNOWS WHERE THE MINES ARE, SO IT NEVER GUESSES WRONG)
3640 DD=999:TA$=" ":FOR Q=0 TO NF-1:J=FQ%(Q):FOR N=0 TO 7:A=J+DO%(N)
3650 IF SC%(A)=0 THEN IF VL%(A)<16 THEN GOSUB 3490:IF D<DD THEN DD=D:TG=A
3660 NEXT N,Q:IF DD<999 THEN RETURN
3670 FOR R=1 TO H:FOR C=1 TO W:A=R*W2+C:IF SC%(A)=0 THEN IF VL%(A)<16 THEN TG=A
3680 NEXT C,R:RETURN
3690 REM MEDIUM: THE NEAREST COVERED MINE, SO THE BLAST SHOWS
3700 TA$=" ":DD=999
3710 FOR M=1 TO MN:A=ML%(M):IF SC%(A)=0 THEN GOSUB 3490:GOSUB 3730
3720 NEXT M:RETURN
3730 IF D<DD THEN DD=D:TG=A
3740 RETURN
3750 REM A KEY DURING THE CHAIN HURRIES IT; Q GOES TO THE MENU
3760 QS=-(K$<>""):IF K$="Q" THEN 2450
3770 RETURN
