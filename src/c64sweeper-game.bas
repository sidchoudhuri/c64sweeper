10 REM **** C64SWEEPER V6 GAME - MINESWEEPER IN C64 BASIC V2 ****
20 REM M0NDE.ITCH.IO - HTTPS://GITHUB.COM/SIDCHOUDHURI/C64SWEEPER
30 POKE 45,PEEK(174):POKE 46,PEEK(175):POKE 55,0:POKE 56,144:CLR
40 IF PEEK(40704)<>80 THEN PRINT CHR$(147);"RUN THE LOADER FIRST":END
50 GOTO 3030
60 REM THE BUSIEST ROUTINES COME FIRST: BASIC LOOKS FOR A LINE FROM THE TOP,
70 REM SO A JUMP TO A LOW LINE IS QUICK. LOOPS AVOID GOTO WHERE THEY CAN.
80 REM OPEN CELL J (FLOOD FILL) AND DRAW IT. EVERY 4TH CELL BLIPS (THE RIPPLE)
90 SC%(J)=1:RV=RV+1:K=VL%(J):IF K=0 THEN SK%(SP)=J:SP=SP+1
100 IF (RV AND 3)=0 THEN POKE V2+1,24+(RV AND 31):POKE V2+4,17:POKE V2+4,16
110 REM CELL J SHOWS K: SYS 39424 (C64SWEEPERVIEW) KEEPS IT IN THE MAP AND DRAWS
120 REM IT IF IT IS IN VIEW
130 POKE 780,K:POKE 781,J AND 255:POKE 782,J/256:SYS 39424:RETURN
140 REM FLOOD FILL FROM THE STACK: OPEN CELLS AND FLAGS ARE LEFT ALONE, ONLY
150 REM THE CELLS THAT CHANGE ARE DRAWN
160 IF SP=0 THEN RETURN
170 SP=SP-1:P=SK%(SP):FOR N=0 TO 7:J=P+DO%(N):IF SC%(J)=0 THEN GOSUB 90
180 NEXT N:GOTO 160
190 REM A MINE NEXT TO THE BLAST: THE TILE BLOWS OFF (FLASH, SPARKS), THE BOMB
200 REM SHOWS. SC 3 = SHOWN
210 K=15:GOSUB 130:POKE VF,40+N*3:POKE VG,129:POKE VG,128:K=16:GOSUB 130
220 K=11:SC%(J)=3:GOTO 130
230 REM EVERY OTHER MINE: THE BOMB SHOWS WITH A TICK; ANY KEY HURRIES THE REST
240 K=11:IF QS=0 THEN POKE VF,20+M:POKE VG,129:POKE VG,128:GET K$:QS=-(K$<>"")
250 GOTO 130
260 REM MAIN LOOP
270 GET K$:IF K$<>"" THEN 320
280 IF TI>=FT THEN FT=TI+8:FP=(FP+1)AND 7:POKE 53287,FC%(FP)
290 IF KT THEN IF TI>KT THEN POKE V1+4,0:POKE V2+4,0:POKE V3+4,0:KT=0
300 IF MT THEN IF TI>MT THEN M$="":GOSUB 2570
310 GOTO 270
320 IF K$="W" OR K$=CHR$(145) THEN GOSUB 460:GOTO 270
330 IF K$="S" OR K$=CHR$(17) THEN GOSUB 480:GOTO 270
340 IF K$="A" OR K$=CHR$(157) THEN GOSUB 500:GOTO 270
350 IF K$="D" OR K$=CHR$(29) THEN GOSUB 520:GOTO 270
360 IF K$=" " THEN GOSUB 1780:IF GS THEN 970
370 IF K$=CHR$(13) OR K$="F" THEN GOSUB 2470:GOTO 270
380 IF K$="M" OR K$="E" OR K$="V" THEN GOSUB 2750:GOTO 270
390 IF K$="T" THEN GOSUB 2720:GOTO 270
400 IF K$="B" THEN GOSUB 2690:GOTO 270
410 IF K$="Z" THEN GOSUB 710:GOTO 270
420 IF K$="I" THEN GOSUB 2950:GOTO 270
430 IF K$="Q" THEN GOSUB 2880:GOTO 270
440 GOTO 270
450 REM MOVING: AT AN EDGE NOTHING MOVES AND THE KEYBOARD BUFFER IS CLEARED
460 IF CY=1 THEN POKE 198,0:RETURN
470 CY=CY-1:I=I-W2:GOTO 550
480 IF CY=H THEN POKE 198,0:RETURN
490 CY=CY+1:I=I+W2:GOTO 550
500 IF CX=1 THEN POKE 198,0:RETURN
510 CX=CX-1:I=I-1:GOTO 550
520 IF CX=W THEN POKE 198,0:RETURN
530 CX=CX+1:I=I+1
540 REM TICK (PULSE), THEN THE CURSOR SPRITE GOES TO CELL CX,CY
550 POKE V1,0:POKE V1+1,35:POKE V1+6,243:POKE V1+4,65:POKE V1+4,64:KT=TI+60
560 IF ZS THEN GOSUB 610
570 POKE 53248,SX%(CX-VX):POKE 53264,SM%(CX-VX)+32:POKE 53249,SY%(CY-VY)
580 POKE 53287,1:POKE 53269,1+AB:FP=2:FT=TI+8:RETURN
590 REM LARGE, ZOOMED IN: THE VIEW MOVES ONE CELL WHEN THE CURSOR COMES WITHIN 2
600 REM CELLS OF ITS EDGE, SO THE CELLS AROUND IT ALWAYS SHOW. SYS 39427 REDRAWS
610 N=VX:P=VY:IF CX-VX<3 AND VX>0 THEN VX=VX-1
620 IF CX-VX>VW-2 AND VX<W-VW THEN VX=VX+1
630 IF CY-VY<3 AND VY>0 THEN VY=VY-1
640 IF CY-VY>VH-2 AND VY<H-VH THEN VY=VY+1
650 IF N=VX AND P=VY THEN RETURN
660 POKE 39436,VX:POKE 39437,VY:SYS 39427
670 REM ARROWS (SPRITES 2-5) WHERE THERE IS MORE BOARD: UP, DOWN, LEFT, RIGHT
680 AB=0:IF ZS THEN AB=-4*(VY>0)-8*(VY<H-VH)-16*(VX>0)-32*(VX<W-VW)
690 POKE 53264,PEEK(53264)OR 32:POKE 53269,(PEEK(53269)AND 3)OR AB:RETURN
700 REM Z (LARGE ONLY): ZOOM OUT TO THE WHOLE BOARD IN SMALL CELLS, OR BACK IN
710 IF SZ<3 THEN POKE 198,0:RETURN
720 ZS=1-ZS:GOSUB 750:GOTO 560
730 REM THE VIEW: SMALL AND MEDIUM SHOW THE WHOLE BOARD IN BIG CELLS; LARGE
740 REM 16X10 BIG CELLS AROUND THE CURSOR (ZOOMED IN) OR ALL OF IT IN SMALL ONES
750 BG=-(SZ<3):IF ZS THEN BG=1
760 CS=1+BG:VW=W:VH=H:VX=0:VY=0:IF ZS=0 THEN 810
770 VW=16:VH=10:VX=CX-8:VY=CY-5:IF VX>W-VW THEN VX=W-VW
780 IF VY>H-VH THEN VY=H-VH
790 IF VX<0 THEN VX=0
800 IF VY<0 THEN VY=0
810 TR=3+INT((20-VH*CS)/2):LC=INT((40-VW*CS)/2):POKE 2040,13+BG
820 POKE 39433,BG:POKE 39434,VW:POKE 39435,VH:POKE 39436,VX:POKE 39437,VY
830 POKE 39438,TR:POKE 39439,LC
840 REM THE CURSOR MOVES TO ITS CELL IN THE NEW VIEW FIRST; THEN THE DRAWING
850 FOR C=1 TO VW:X=23+8*(LC+(C-1)*CS):SM%(C)=-(X>255):SX%(C)=X AND 255:NEXT C
860 FOR R=1 TO VH:SY%(R)=49+8*(TR+(R-1)*CS):NEXT R
870 POKE 53248,SX%(CX-VX):POKE 53264,SM%(CX-VX)+32:POKE 53249,SY%(CY-VY)
880 FOR R=2 TO 23:POKE 214,R:POKE 211,0:SYS 58732:PRINT BL$;:NEXT R
890 REM FRAME (BLUE): ITS LINES SIT THE SAME DISTANCE FROM THE TILES ALL ROUND
900 A=1024+40*(TR-1)+LC-1:P=A+40*(VH*CS+1):N=VW*CS+1
910 FOR C=1 TO N-1:POKE A+C+CM,14:POKE A+C,79:POKE P+C+CM,14:POKE P+C,88:NEXT C
920 POKE A+CM,14:POKE A,78:POKE A+N+CM,14:POKE A+N,80
930 POKE P+CM,14:POKE P,82:POKE P+N+CM,14:POKE P+N,83
940 FOR R=1 TO VH*CS:Q=A+40*R:POKE Q+CM,14:POKE Q,81:POKE Q+N+CM,14:POKE Q+N,89
950 NEXT R:SYS 39427:GOTO 680
960 REM GAME OVER (WON OR LOST): SPACE PLAYS AGAIN, Q GOES TO THE MENU
970 TE=TI+45
980 IF TI<TE THEN 980
990 POKE 198,0
1000 GET K$:IF K$=" " THEN 3580
1010 IF K$="Q" THEN 2910
1020 IF K$="Z" AND SZ=3 THEN ZS=1-ZS:GOSUB 750
1030 IF KT THEN IF TI>KT THEN POKE V1+4,0:POKE V2+4,0:POKE V3+4,0:KT=0
1040 GOTO 1000
1050 REM CHOOSE A BOARD. THE NEXT GAME GOES BACK TO THE TUNE YOU CHOSE
1060 POKE 53269,0:SYS 51200:BA=0
1070 IF PS<>SG THEN POKE 36871,SG:SYS 36864:PS=SG
1080 R=8:C=14:GOSUB 2590:PRINT "{wht}C64S{rvon}WEEPER {rvof}V6"
1090 R=10:C=13:GOSUB 2590:PRINT "{grn}C{rvon}HOOSE A BOARD{rvof}"
1100 R=12:C=10:GOSUB 2590:PRINT "{cyn}S {grn}- {wht}S{rvon}MALL    {grn}{rvof}8{rvon}X{rvof}8"
1110 R=13:C=10:GOSUB 2590:PRINT "{cyn}M {grn}- {wht}M{rvon}EDIUM  {grn}{rvof}16{rvon}X{rvof}10"
1120 R=14:C=10:GOSUB 2590:PRINT "{cyn}L {grn}- {wht}L{rvon}ARGE   {grn}{rvof}24{rvon}X{rvof}14"
1130 R=17:C=10:GOSUB 2590:PRINT "{cyn}Q {grn}- {wht}B{rvon}ACK TO THE MENU{rvof}"
1140 R=16:C=10:GOSUB 2590:PRINT "{cyn}B {grn}- {wht}S{rvon}TYLE{rvof}: {grn}";SN$(SY);
1150 REM KEYS; A CELL OPENS OR IS COVERED AGAIN 8 TIMES A SECOND, NOW AND THEN A
1160 REM BOMB SHOWS (AT BA) AND GOES OFF, AS IN THE MENU
1170 GET K$:IF K$<>"" THEN 1300
1180 IF TI<NT THEN 1170
1190 NT=TI+8:IF BA THEN 1260
1200 Y=INT(RND(1)*25):X=INT(RND(1)*40)
1210 IF Y>5 AND Y<19 AND X>7 AND X<33 THEN 1170
1220 A=1024+40*Y+X:IF PEEK(A)<>73 THEN POKE A,73:POKE A+CM,14:GOTO 1170
1230 IF RND(1)<.06 THEN POKE A+CM,15:POKE A,75:BA=A:BT=0:GOTO 1170
1240 IF RND(1)<.55 THEN N=RND(1)*8:POKE A+CM,MK%(N):POKE A,MC%(N)
1250 GOTO 1170
1260 BT=BT+1:IF BT<3 THEN 1170
1270 IF BT=3 THEN POKE BA,85:GOTO 1170
1280 IF BT=4 THEN POKE BA+CM,10:POKE BA,86:GOTO 1170
1290 POKE BA+CM,6:POKE BA,64:BA=0:GOTO 1170
1300 IF K$="B" THEN SY=(SY+1)AND 3:GOSUB 2670:GOTO 1140
1310 SZ=0:IF K$="S" OR K$="1" THEN SZ=1
1320 IF K$="M" OR K$="2" THEN SZ=2
1330 IF K$="L" OR K$="3" THEN SZ=3
1340 IF K$="Q" THEN 2910
1350 IF SZ=0 THEN 1170
1360 W=BW%(SZ):H=BH%(SZ):MN=BM%(SZ):RETURN
1370 REM NEW BOARD. BG = 1 FOR BIG CELLS, CS = CELL SIZE IN CHARACTERS
1380 PRINT "{clr}";:GOSUB 1580
1390 M$="{wht}C{rvon}REATING THE BOARD {rvof}...":GOSUB 2570
1400 X=RND(-(TI*(PEEK(53266)+TI)))
1410 REM 32 CELLS TO A ROW, SO MACHINE CODE FINDS A CELL'S ROW AND COLUMN
1420 REM QUICKLY. LARGE STARTS ZOOMED IN (ZS)
1430 W2=32:NC=W*H:ZS=-(SZ=3):AB=0
1440 FOR I=0 TO (H+2)*W2-1:VL%(I)=0:SC%(I)=1:NEXT I
1450 FOR R=1 TO H:FOR C=1 TO W:SC%(R*W2+C)=0:NEXT C,R
1460 POKE 39440,W:POKE 39441,H:SYS 39430
1470 REM THE 8 CELLS AROUND A CELL
1480 DO%(0)=-W2-1:DO%(1)=-W2:DO%(2)=1-W2:DO%(3)=-1
1490 DO%(4)=1:DO%(5)=W2-1:DO%(6)=W2:DO%(7)=W2+1
1500 REM MINES: EACH ONE ADDS 1 TO THE 8 CELLS AROUND IT
1510 FOR K=1 TO MN
1520 P=(INT(RND(1)*H)+1)*W2+INT(RND(1)*W)+1:IF VL%(P)>15 THEN 1520
1530 VL%(P)=VL%(P)+16:ML%(K)=P:FOR N=0 TO 7:J=P+DO%(N):VL%(J)=VL%(J)+1:NEXT N,K
1540 REM FL FLAGS LEFT, RV CELLS OPEN, FR FIRST REVEAL, I THE CURSOR CELL
1550 FL=MN:RV=0:GS=0:FR=1:CX=1:CY=1:I=W2+1:GOSUB 750
1560 M$="":GOSUB 2570:GOSUB 1630:POKE 198,0:GOTO 560
1570 REM HEADER ROWS 0-1
1580 R=0:C=2:GOSUB 2590:PRINT "{wht}C64S{rvon}WEEPER {rvof}V6  {grn}";DN$(SZ);
1590 C=27:GOSUB 2590:PRINT "{grn}M{rvon}INES{rvof}";
1600 R=1:C=1:GOSUB 2590:PRINT "{cyn}S{rvon}PACE {grn}{rvof}R{rvon}EVEAL {cyn}{rvof}R{rvon}ETURN {grn}{rvof}F{rvon}LAG {rvof}";
1610 PRINT "{cyn}I {grn}H{rvon}ELP {cyn}{rvof}Q {grn}M{rvon}ENU{rvof}";:RETURN
1620 REM FLAGS LEFT
1630 R=0:C=33:GOSUB 2590:PRINT "{wht}";RIGHT$(" "+MID$(STR$(FL),2),2);:RETURN
1640 REM SPRITE 0, THE CURSOR: A 10X10 OUTLINE (BLOCK 13) OR 18X18 FOR BIG CELLS
1650 REM (BLOCK 14). SPRITE 1, THE BLAST: MULTICOLOUR, DOUBLE SIZE (BLOCKS 209+)
1660 FOR I=0 TO 62:POKE 832+I,0:POKE 896+I,0:NEXT I
1670 FOR I=1 TO 8:POKE 832+3*I,128:POKE 833+3*I,64:NEXT I
1680 FOR I=0 TO 1:POKE 832+27*I,255:POKE 833+27*I,192:NEXT I
1690 FOR I=1 TO 16:POKE 896+3*I,128:POKE 898+3*I,64:NEXT I
1700 FOR I=0 TO 1:J=896+51*I:POKE J,255:POKE J+1,255:POKE J+2,192:NEXT I
1710 POKE 53287,14:POKE 53276,2:POKE 53277,2:POKE 53271,2
1720 REM SPRITES 2-5: THE ARROWS AROUND THE ZOOMED-IN VIEW, WHITE
1730 FOR I=0 TO 3:POKE 2042+I,215+I:POKE 53289+I,1:NEXT I
1740 POKE 53252,181:POKE 53253,67:POKE 53254,181:POKE 53255,237
1750 POKE 53256,46:POKE 53257,151:POKE 53258,62:POKE 53259,151:RETURN
1760 REM REVEAL THE CURSOR CELL: THE TILE PRESSES IN, THEN OPENS. THE FIRST
1770 REM REVEAL IS ALWAYS SAFE. THE CLICK (TRIANGLE) RISES WITH THE NUMBER
1780 IF SC%(I) THEN RETURN
1790 IF FR THEN FR=0:IF VL%(I)>15 THEN GOSUB 1880
1800 J=I:K=14:GOSUB 130:IF VL%(I)>15 THEN 1950
1810 V=VL%(I):POKE V2,0:POKE V2+1,20+6*V:POKE V2+6,248:POKE V2+4,17:POKE V2+4,16
1820 KT=TI+60:SC%(I)=1:RV=RV+1:K=V:GOSUB 130
1830 IF V=0 THEN SP=1:SK%(0)=I:GOSUB 160
1840 IF RV=NC-MN THEN 2320
1850 RETURN
1860 REM THE FIRST REVEAL HIT A MINE: THE MINE MOVES TO A FREE CELL AND ONLY
1870 REM THE COUNTS AROUND THE TWO CELLS CHANGE
1880 J=(INT(RND(1)*H)+1)*W2+INT(RND(1)*W)+1:IF VL%(J)>15 THEN 1880
1890 VL%(I)=VL%(I)-16:VL%(J)=VL%(J)+16:FOR N=0 TO 7:A=I+DO%(N):VL%(A)=VL%(A)-1
1900 A=J+DO%(N):VL%(A)=VL%(A)+1:NEXT N
1910 FOR K=1 TO MN:IF ML%(K)=I THEN ML%(K)=J
1920 NEXT K:RETURN
1930 REM A MINE. MUSIC: WITH ONE SID IT STOPS FOR THE BLAST AND COMES BACK AS
1940 REM MINES; WITH TWO SIDS IT CHANGES TO MINES AND PLAYS ON
1950 GS=1:POKE 53269,0:QS=0
1960 IF S2=0 THEN SYS 36867
1970 IF S2 THEN IF PS THEN POKE 36871,0:SYS 36864:PS=0
1980 REM THE BLAST USES 3 VOICES (ONE SID: THE MUSIC'S TWO AS WELL): B3 A
1990 REM FALLING ROAR (NOISE), B1 A LOW THUMP (TRIANGLE), B2 CRACKLE (NOISE)
2000 B1=54272+32*S2:B2=B1+7:B3=B1+14:K=11:GOSUB 130
2010 X=8*(LC+(CX-1-VX)*CS)+4*CS:Y=29+8*(TR+(CY-1-VY)*CS)+4*CS
2020 POKE 53250,X AND 255:POKE 53251,Y:POKE 53264,2*-(X>255)
2030 POKE B1,0:POKE B2,0:POKE B3,0:POKE B1+5,0:POKE B2+5,0:POKE B3+5,0
2040 POKE B3+6,252:POKE B1+6,249:POKE B2+6,242:POKE B3+4,129:POKE B1+4,17
2050 REM 6 FRAMES: SPRITE PICTURE AND COLOURS, BORDER, SHAKE, SOUND; CRATER AT 3
2060 FOR F=0 TO 5:POKE 2041,209+F:POKE 53285,BF%(F,0):POKE 53286,BF%(F,1)
2070 POKE 53288,BF%(F,2):POKE 53269,2:POKE 53280,BD%(F):POKE 53265,27+SH%(F)
2080 POKE B3+1,60-10*F:POKE B1+1,12-2*F
2090 POKE B2+1,200-RND(1)*100:POKE B2+4,128:POKE B2+4,129
2100 IF F=2 THEN K=12:GOSUB 130
2110 TE=TI+5
2120 IF TI<TE THEN 2120
2130 NEXT F
2140 POKE 53269,0:POKE 53265,27:POKE 53280,0
2150 POKE B3+4,128:POKE B1+4,16:POKE B2+4,128
2160 IF S2=0 THEN POKE 36871,0:SYS 36864:PS=0
2170 REM THE OTHER MINES: THE ONES NEXT TO THE BLAST GO OFF FIRST, THEN THE REST
2180 REM SHOW ONE BY ONE. FLAGGED MINES STAY FLAGS
2190 POKE 198,0:POKE V3,0:POKE V3+6,247:POKE V3+5,0
2200 FOR N=0 TO 7:J=I+DO%(N):IF VL%(J)>15 THEN IF SC%(J)=0 THEN GOSUB 210
2210 NEXT N
2220 FOR M=1 TO MN:J=ML%(M):IF SC%(J)=0 THEN IF J<>I THEN GOSUB 240
2230 NEXT M:KT=TI+150
2240 REM WRONG FLAGS ARE CROSSED OUT
2250 IF FL=MN THEN 2280
2260 FOR J=W2+1 TO H*W2+W:IF SC%(J)=2 THEN IF VL%(J)<16 THEN GOSUB 2450
2270 NEXT J
2280 M$="{wht}B{rvon}OOM{rvof}! {grn}S{rvon}PACE {rvof}- {rvon}PLAY AGAIN  {rvof}Q - {rvon}MENU{rvof}":GOTO 2570
2290 REM ALL CLEAR: A FLAG GOES UP ON EVERY MINE WITH RISING NOTES (NO TILE
2300 REM BEHIND IT, SO THE GREEN SHOWS), A COLOUR WAVE RUNS OVER THE FLAGS
2310 REM (WHITE, YELLOW, GREEN), THEN THE FANFARE (TRIANGLE)
2320 GS=2:POKE 53269,0:N=0:POKE V3,0:POKE V3+6,246
2330 FOR M=1 TO MN:J=ML%(M):GOSUB 2400:NEXT M:FL=0:GOSUB 1630
2340 FOR N=0 TO 2:Z=9:IF N=1 THEN Z=15
2350 IF N=2 THEN Z=13
2360 POKE 39985,Z:K=17:FOR M=1 TO MN:J=ML%(M):GOSUB 130:NEXT M,N
2370 POKE V3,0:POKE V3+6,248
2380 X=20:Y=8:GOSUB 2420:X=30:GOSUB 2420:X=45:Y=16:GOSUB 2420:KT=TI+60
2390 M$="{wht}Y{rvon}OU WIN{rvof}! {grn}S{rvon}PACE {rvof}- {rvon}PLAY AGAIN  {rvof}Q - {rvon}MENU{rvof}":GOTO 2570
2400 K=17:GOSUB 130:POKE V3+1,AR%(N AND 7):POKE V3+4,17:POKE V3+4,16:N=N+1
2410 RETURN
2420 POKE V3+1,X:POKE V3+4,17:TE=TI+Y
2430 IF TI<TE THEN 2430
2440 POKE V3+4,16:RETURN
2450 K=13:GOTO 130
2460 REM FLAG OR UNFLAG THE CURSOR CELL
2470 IF SC%(I)=1 THEN RETURN
2480 J=I:IF SC%(I)=0 THEN 2500
2490 SC%(I)=0:FL=FL+1:K=9:GOSUB 130:GOTO 2520
2500 IF FL=0 THEN RETURN
2510 SC%(I)=2:FL=FL-1:K=10:GOSUB 130
2520 GOSUB 2540:GOTO 1630
2530 REM BEEP (SAWTOOTH)
2540 POKE V2,100:POKE V2+1,10:POKE V2+6,240:POKE V2+4,33:POKE V2+4,32:KT=TI+60
2550 RETURN
2560 REM STATUS LINE (ROW 24): M$, CENTRED
2570 MT=0:GOSUB 2610:R=24:C=0:GOSUB 2590:PRINT BL$;
2580 C=INT((40-N)/2):GOSUB 2590:PRINT M$;:RETURN
2590 POKE 214,R:POKE 211,C:SYS 58732:RETURN
2600 REM N = HOW MANY CHARACTERS OF M$ SHOW (NOT COUNTING CONTROL CODES)
2610 N=0:IF M$="" THEN RETURN
2620 FOR K=1 TO LEN(M$):A=ASC(MID$(M$,K,1))
2630 N=N-((A>31 AND A<128) OR A>159):NEXT K:RETURN
2640 REM BOARD STYLE: SYS 51264 PUTS THE SHAPES OF STYLE SY INTO THE CHARACTER
2650 REM SET, SO EVERY CELL ON THE SCREEN CHANGES AT ONCE. THE SECOND SHARED
2660 REM COLOUR IS LIGHT GREY (CLASSIC) OR BLUE (BLUE, OUTLINE, DASHED)
2670 POKE 780,SY:SYS 51264:POKE 53283,15+9*(SY>0):POKE 40712,SY+1:RETURN
2680 REM B: THE NEXT STYLE, NAMED ON THE STATUS LINE FOR 2 SECONDS
2690 SY=(SY+1)AND 3:GOSUB 2670
2700 M$="{wht}S{rvon}TYLE{rvof}: "+SN$(SY):GOSUB 2570:MT=TI+120:RETURN
2710 REM T: THE OTHER TUNE, NAMED ON THE STATUS LINE FOR 2 SECONDS
