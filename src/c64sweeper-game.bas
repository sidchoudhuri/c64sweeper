10 REM **** C64SWEEPER V5 GAME - MINESWEEPER IN C64 BASIC V2 ****
20 REM M0NDE.ITCH.IO - HTTPS://GITHUB.COM/SIDCHOUDHURI/C64SWEEPER
30 POKE 45,PEEK(174):POKE 46,PEEK(175):POKE 55,0:POKE 56,144:CLR
40 IF PEEK(40704)<>80 THEN PRINT CHR$(147);"RUN THE LOADER FIRST":END
50 GOTO 2940
60 REM THE BUSIEST ROUTINES COME FIRST: BASIC LOOKS FOR A LINE FROM THE TOP,
70 REM SO A JUMP TO A LOW LINE IS QUICK. LOOPS AVOID GOTO WHERE THEY CAN.
80 REM OPEN CELL J (FLOOD FILL) AND DRAW IT. EVERY 4TH CELL BLIPS (THE RIPPLE)
90 SC%(J)=1:RV=RV+1:K=VL%(J):IF K=0 THEN SK%(SP)=J:SP=SP+1
100 IF (RV AND 3)=0 THEN POKE V2+1,24+(RV AND 31):POKE V2+4,17:POKE V2+4,16
110 REM DRAW CELL J AS K. A BIG CELL IS PRINTED: T$(K) HOLDS ITS COLOUR AND ITS
120 REM 4 CHARACTERS (PRINT IS MUCH QUICKER THAN 8 POKES)
130 IF BG THEN POKE 214,AD%(J):POKE 211,XX%(J):SYS 58732:PRINT T$(K);:RETURN
140 A=AD%(J):POKE A+CM,CK%(K):POKE A,CH%(K):RETURN
150 REM FLOOD FILL FROM THE STACK: OPEN CELLS AND FLAGS ARE LEFT ALONE, ONLY
160 REM THE CELLS THAT CHANGE ARE DRAWN
170 IF SP=0 THEN RETURN
180 SP=SP-1:P=SK%(SP):FOR N=0 TO 7:J=P+DO%(N):IF SC%(J)=0 THEN GOSUB 90
190 NEXT N:GOTO 170
200 REM A MINE NEXT TO THE BLAST: THE TILE BLOWS OFF (FLASH, SPARKS), THE BOMB
210 REM SHOWS. SC 3 = SHOWN
220 K=15:GOSUB 130:POKE VF,40+N*3:POKE VG,129:POKE VG,128:K=16:GOSUB 130
230 K=11:SC%(J)=3:GOTO 130
240 REM EVERY OTHER MINE: THE BOMB SHOWS WITH A TICK; ANY KEY HURRIES THE REST
250 K=11:IF QS=0 THEN POKE VF,20+M:POKE VG,129:POKE VG,128:GET K$:QS=-(K$<>"")
260 GOTO 130
270 REM MAIN LOOP
280 GET K$:IF K$<>"" THEN 330
290 IF TI>=FT THEN FT=TI+8:FP=(FP+1)AND 7:POKE 53287,FC%(FP)
300 IF KT THEN IF TI>KT THEN POKE V1+4,0:POKE V2+4,0:POKE V3+4,0:KT=0
310 IF MT THEN IF TI>MT THEN M$="":GOSUB 2480
320 GOTO 280
330 IF K$="W" OR K$=CHR$(145) THEN GOSUB 460:GOTO 280
340 IF K$="S" OR K$=CHR$(17) THEN GOSUB 480:GOTO 280
350 IF K$="A" OR K$=CHR$(157) THEN GOSUB 500:GOTO 280
360 IF K$="D" OR K$=CHR$(29) THEN GOSUB 520:GOTO 280
370 IF K$=" " THEN GOSUB 1640:IF GS THEN 590
380 IF K$=CHR$(13) OR K$="F" THEN GOSUB 2380:GOTO 280
390 IF K$="M" OR K$="E" OR K$="V" THEN GOSUB 2660:GOTO 280
400 IF K$="T" THEN GOSUB 2630:GOTO 280
410 IF K$="B" THEN GOSUB 2600:GOTO 280
420 IF K$="I" THEN GOSUB 2860:GOTO 280
430 IF K$="Q" THEN GOSUB 2790:GOTO 280
440 GOTO 280
450 REM MOVING: AT AN EDGE NOTHING MOVES AND THE KEYBOARD BUFFER IS CLEARED
460 IF CY=1 THEN POKE 198,0:RETURN
470 CY=CY-1:I=I-W2:GOTO 550
480 IF CY=H THEN POKE 198,0:RETURN
490 CY=CY+1:I=I+W2:GOTO 550
500 IF CX=1 THEN POKE 198,0:RETURN
510 CX=CX-1:I=I-1:GOTO 550
520 IF CX=W THEN POKE 198,0:RETURN
530 CX=CX+1:I=I+1
540 REM TICK (PULSE), THEN THE CURSOR SPRITE GOES TO CELL CX,CY
550 POKE V1,0:POKE V1+1,35:POKE V1+6,243:POKE V1+4,65:POKE V1+4,64:KT=TI+60
560 POKE 53248,SX%(CX):POKE 53264,SM%(CX):POKE 53249,SY%(CY)
570 POKE 53287,1:POKE 53269,1:FP=2:FT=TI+8:RETURN
580 REM GAME OVER (WON OR LOST): SPACE PLAYS AGAIN, Q GOES TO THE MENU
590 TE=TI+45
600 IF TI<TE THEN 600
610 POKE 198,0
620 GET K$:IF K$=" " THEN 3710
630 IF K$="Q" THEN 2820
640 IF KT THEN IF TI>KT THEN POKE V1+4,0:POKE V2+4,0:POKE V3+4,0:KT=0
650 GOTO 620
660 REM CHOOSE A BOARD. THE NEXT GAME GOES BACK TO THE TUNE YOU CHOSE
670 POKE 53269,0:SYS 51200:BA=0
680 IF PS<>SG THEN POKE 36871,SG:SYS 36864:PS=SG
690 R=8:C=14:GOSUB 2500:PRINT "{wht}C64S{rvon}WEEPER {rvof}V5"
700 R=10:C=13:GOSUB 2500:PRINT "{grn}C{rvon}HOOSE A BOARD{rvof}"
710 R=12:C=10:GOSUB 2500:PRINT "{cyn}S {grn}- {wht}S{rvon}MALL    {grn}{rvof}8{rvon}X{rvof}8"
720 R=13:C=10:GOSUB 2500:PRINT "{cyn}M {grn}- {wht}M{rvon}EDIUM  {grn}{rvof}16{rvon}X{rvof}10"
730 R=14:C=10:GOSUB 2500:PRINT "{cyn}L {grn}- {wht}L{rvon}ARGE   {grn}{rvof}24{rvon}X{rvof}14"
740 R=17:C=10:GOSUB 2500:PRINT "{cyn}Q {grn}- {wht}B{rvon}ACK TO THE MENU{rvof}"
750 R=16:C=10:GOSUB 2500:PRINT "{cyn}B {grn}- {wht}S{rvon}TYLE{rvof}: {grn}";SN$(SY);
760 REM KEYS; A CELL OPENS OR IS COVERED AGAIN 8 TIMES A SECOND, NOW AND THEN A
770 REM BOMB SHOWS (AT BA) AND GOES OFF, AS IN THE MENU
780 GET K$:IF K$<>"" THEN 910
790 IF TI<NT THEN 780
800 NT=TI+8:IF BA THEN 870
810 Y=INT(RND(1)*25):X=INT(RND(1)*40)
820 IF Y>5 AND Y<19 AND X>7 AND X<33 THEN 780
830 A=1024+40*Y+X:IF PEEK(A)<>73 THEN POKE A,73:POKE A+CM,14:GOTO 780
840 IF RND(1)<.06 THEN POKE A+CM,15:POKE A,75:BA=A:BT=0:GOTO 780
850 IF RND(1)<.55 THEN N=RND(1)*8:POKE A+CM,MK%(N):POKE A,MC%(N)
860 GOTO 780
870 BT=BT+1:IF BT<3 THEN 780
880 IF BT=3 THEN POKE BA,85:GOTO 780
890 IF BT=4 THEN POKE BA+CM,10:POKE BA,86:GOTO 780
900 POKE BA+CM,6:POKE BA,64:BA=0:GOTO 780
910 IF K$="B" THEN SY=(SY+1)AND 3:GOSUB 2580:GOTO 750
920 SZ=0:IF K$="S" OR K$="1" THEN SZ=1
930 IF K$="M" OR K$="2" THEN SZ=2
940 IF K$="L" OR K$="3" THEN SZ=3
950 IF K$="Q" THEN 2820
960 IF SZ=0 THEN 780
970 W=BW%(SZ):H=BH%(SZ):MN=BM%(SZ):RETURN
980 REM NEW BOARD. BG = 1 FOR BIG CELLS, CS = CELL SIZE IN CHARACTERS
990 PRINT "{clr}";:GOSUB 1480
1000 M$="{wht}C{rvon}REATING THE BOARD {rvof}...":GOSUB 2480
1010 X=RND(-(TI*(PEEK(53266)+TI)))
1020 BG=-(SZ<3):CS=1+BG:W2=W+2:NC=W*H:TR=3+INT((20-H*CS)/2):LC=INT((40-W*CS)/2)
1030 POKE 2040,13+BG
1040 FOR I=0 TO (H+2)*W2-1:VL%(I)=0:SC%(I)=1:NEXT I
1050 REM FRAME (BLUE): TOP AND BOTTOM LINES AND THE CORNERS. ITS LINES SIT THE
1060 REM SAME DISTANCE FROM THE TILES ON ALL FOUR SIDES
1070 A=1024+40*(TR-1)+LC-1:J=A+40*(H*CS+1):K=W*CS+1
1080 FOR C=1 TO K-1:POKE A+C+CM,14:POKE A+C,79
1090 POKE J+C+CM,14:POKE J+C,88:NEXT C
1100 POKE A+CM,14:POKE A,78:POKE A+K+CM,14:POKE A+K,80
1110 POKE J+CM,14:POKE J,82:POKE J+K+CM,14:POKE J+K,83
1120 REM A ROW OF TILES IS ONE STRING, PRINTED IN LIGHT BLUE (COLOUR 14). THE
1130 REM LAST COLUMN AND THE LAST ROW USE THE EDGE TILES (NO LINE TOWARDS THE
1140 REM FRAME). SMALL CELLS: T1$ A ROW, T3$ THE LAST ROW. BIG CELLS: T1$ TOP
1150 REM HALVES, T2$ BOTTOM HALVES, T4$ THOSE OF THE LAST ROW (REVERSE ON)
1160 T1$="":T2$="":T3$="":T4$="":FOR C=2 TO W:IF BG=0 THEN T1$=T1$+CHR$(201)
1170 IF BG=0 THEN T3$=T3$+CHR$(219)
1180 IF BG THEN T1$=T1$+CHR$(192)+CHR$(193):T2$=T2$+CHR$(194)+CHR$(195)
1190 IF BG THEN T4$=T4$+CHR$(174)+CHR$(175)
1200 NEXT C:IF BG=0 THEN T1$=T1$+CHR$(218):T3$=T3$+CHR$(220)
1210 IF BG THEN T1$=T1$+CHR$(192)+CHR$(172):T2$=T2$+CHR$(194)+CHR$(173)
1220 IF BG THEN T4$=T4$+CHR$(174)+CHR$(176):T3$=T1$
1230 RX=LC+(W-1)*CS:HW=H*W2
1240 REM EVERY ROW: THE SIDES OF THE FRAME, THE TILES, AND THE TABLES
1250 FOR R=1 TO H:Y=TR+(R-1)*CS:A=1024+40*Y+LC-1:J=R*W2:SY%(R)=49+8*Y
1260 POKE A+CM,14:POKE A,81:POKE A+K+CM,14:POKE A+K,89:POKE 214,Y:POKE 211,LC
1270 P$=T1$:Q$=T2$:IF R=H THEN P$=T3$:Q$=T4$
1280 SYS 58732:IF BG=0 THEN PRINT "{lblu}";P$;
1290 IF BG THEN POKE A+40+CM,14:POKE A+40,81:POKE A+K+40+CM,14:POKE A+K+40,89
1300 IF BG THEN PRINT "{lblu}{rvon}";P$;:POKE 214,Y+1:POKE 211,LC:SYS 58732
1310 IF BG THEN PRINT "{rvon}";Q$;"{rvof}";
1320 FOR C=1 TO W:Q=J+C:X=LC+(C-1)*CS:SC%(Q)=0:XX%(Q)=X:AD%(Q)=A+1+(C-1)*CS
1330 IF BG THEN AD%(Q)=Y
1340 NEXT C,R
1350 REM CURSOR SPRITE X FOR EVERY COLUMN (SM = 1 PAST X 255)
1360 FOR C=1 TO W:X=23+8*(LC+(C-1)*CS):SM%(C)=-(X>255):SX%(C)=X AND 255:NEXT C
1370 REM THE 8 CELLS AROUND A CELL
1380 DO%(0)=-W2-1:DO%(1)=-W2:DO%(2)=1-W2:DO%(3)=-1
1390 DO%(4)=1:DO%(5)=W2-1:DO%(6)=W2:DO%(7)=W2+1
1400 REM MINES: EACH ONE ADDS 1 TO THE 8 CELLS AROUND IT
1410 FOR K=1 TO MN
1420 P=(INT(RND(1)*H)+1)*W2+INT(RND(1)*W)+1:IF VL%(P)>15 THEN 1420
1430 VL%(P)=VL%(P)+16:ML%(K)=P:FOR N=0 TO 7:J=P+DO%(N):VL%(J)=VL%(J)+1:NEXT N,K
1440 REM FL FLAGS LEFT, RV CELLS OPEN, FR FIRST REVEAL, I THE CURSOR CELL
1450 FL=MN:RV=0:GS=0:FR=1:CX=1:CY=1:I=W2+1
1460 M$="":GOSUB 2480:GOSUB 1530:POKE 198,0:GOTO 560
1470 REM HEADER ROWS 0-1
1480 R=0:C=2:GOSUB 2500:PRINT "{wht}C64S{rvon}WEEPER {rvof}V5  {grn}";DN$(SZ);
1490 C=27:GOSUB 2500:PRINT "{grn}M{rvon}INES{rvof}";
1500 R=1:C=1:GOSUB 2500:PRINT "{cyn}S{rvon}PACE {grn}{rvof}R{rvon}EVEAL {cyn}{rvof}R{rvon}ETURN {grn}{rvof}F{rvon}LAG {rvof}";
1510 PRINT "{cyn}I {grn}H{rvon}ELP {cyn}{rvof}Q {grn}M{rvon}ENU{rvof}";:RETURN
1520 REM FLAGS LEFT
1530 R=0:C=33:GOSUB 2500:PRINT "{wht}";RIGHT$(" "+MID$(STR$(FL),2),2);:RETURN
1540 REM SPRITE 0, THE CURSOR: A 10X10 OUTLINE (BLOCK 13) OR 18X18 FOR BIG CELLS
1550 REM (BLOCK 14). SPRITE 1, THE BLAST: MULTICOLOUR, DOUBLE SIZE (BLOCKS 209+)
1560 FOR I=0 TO 62:POKE 832+I,0:POKE 896+I,0:NEXT I
1570 FOR I=1 TO 8:POKE 832+3*I,128:POKE 833+3*I,64:NEXT I
1580 FOR I=0 TO 1:POKE 832+27*I,255:POKE 833+27*I,192:NEXT I
1590 FOR I=1 TO 16:POKE 896+3*I,128:POKE 898+3*I,64:NEXT I
1600 FOR I=0 TO 1:J=896+51*I:POKE J,255:POKE J+1,255:POKE J+2,192:NEXT I
1610 POKE 53287,14:POKE 53276,2:POKE 53277,2:POKE 53271,2:RETURN
1620 REM REVEAL THE CURSOR CELL: THE TILE PRESSES IN, THEN OPENS. THE FIRST
1630 REM REVEAL IS ALWAYS SAFE. THE CLICK (TRIANGLE) RISES WITH THE NUMBER
1640 IF SC%(I) THEN RETURN
1650 IF FR THEN FR=0:IF VL%(I)>15 THEN GOSUB 1740
1660 J=I:K=14:GOSUB 130:IF VL%(I)>15 THEN 1810
1670 V=VL%(I):POKE V2,0:POKE V2+1,20+6*V:POKE V2+6,248:POKE V2+4,17:POKE V2+4,16
1680 KT=TI+60:SC%(I)=1:RV=RV+1:K=V:GOSUB 130
1690 IF V=0 THEN SP=1:SK%(0)=I:GOSUB 170
1700 IF RV=NC-MN THEN 2180
1710 RETURN
1720 REM THE FIRST REVEAL HIT A MINE: THE MINE MOVES TO A FREE CELL AND ONLY
1730 REM THE COUNTS AROUND THE TWO CELLS CHANGE
1740 J=(INT(RND(1)*H)+1)*W2+INT(RND(1)*W)+1:IF VL%(J)>15 THEN 1740
1750 VL%(I)=VL%(I)-16:VL%(J)=VL%(J)+16:FOR N=0 TO 7:A=I+DO%(N):VL%(A)=VL%(A)-1
1760 A=J+DO%(N):VL%(A)=VL%(A)+1:NEXT N
1770 FOR K=1 TO MN:IF ML%(K)=I THEN ML%(K)=J
1780 NEXT K:RETURN
1790 REM A MINE. MUSIC: WITH ONE SID IT STOPS FOR THE BLAST AND COMES BACK AS
1800 REM MINES; WITH TWO SIDS IT CHANGES TO MINES AND PLAYS ON
1810 GS=1:POKE 53269,0:QS=0
1820 IF S2=0 THEN SYS 36867
1830 IF S2 THEN IF PS THEN POKE 36871,0:SYS 36864:PS=0
1840 REM THE BLAST USES 3 VOICES (ONE SID: THE MUSIC'S TWO AS WELL): B3 A
1850 REM FALLING ROAR (NOISE), B1 A LOW THUMP (TRIANGLE), B2 CRACKLE (NOISE)
1860 B1=54272+32*S2:B2=B1+7:B3=B1+14:K=11:GOSUB 130
1870 X=8*(LC+(CX-1)*CS)+4*CS:Y=29+8*(TR+(CY-1)*CS)+4*CS
1880 POKE 53250,X AND 255:POKE 53251,Y:POKE 53264,2*-(X>255)
1890 POKE B1,0:POKE B2,0:POKE B3,0:POKE B1+5,0:POKE B2+5,0:POKE B3+5,0
1900 POKE B3+6,252:POKE B1+6,249:POKE B2+6,242:POKE B3+4,129:POKE B1+4,17
1910 REM 6 FRAMES: SPRITE PICTURE AND COLOURS, BORDER, SHAKE, SOUND; CRATER AT 3
1920 FOR F=0 TO 5:POKE 2041,209+F:POKE 53285,BF%(F,0):POKE 53286,BF%(F,1)
1930 POKE 53288,BF%(F,2):POKE 53269,2:POKE 53280,BD%(F):POKE 53265,27+SH%(F)
1940 POKE B3+1,60-10*F:POKE B1+1,12-2*F
1950 POKE B2+1,200-RND(1)*100:POKE B2+4,128:POKE B2+4,129
1960 IF F=2 THEN K=12:GOSUB 130
1970 TE=TI+5
1980 IF TI<TE THEN 1980
1990 NEXT F
2000 POKE 53269,0:POKE 53265,27:POKE 53280,0
2010 POKE B3+4,128:POKE B1+4,16:POKE B2+4,128
2020 IF S2=0 THEN POKE 36871,0:SYS 36864:PS=0
2030 REM THE OTHER MINES: THE ONES NEXT TO THE BLAST GO OFF FIRST, THEN THE REST
2040 REM SHOW ONE BY ONE. FLAGGED MINES STAY FLAGS
2050 POKE 198,0:POKE V3,0:POKE V3+6,247:POKE V3+5,0
2060 FOR N=0 TO 7:J=I+DO%(N):IF VL%(J)>15 THEN IF SC%(J)=0 THEN GOSUB 220
2070 NEXT N
2080 FOR M=1 TO MN:J=ML%(M):IF SC%(J)=0 THEN IF J<>I THEN GOSUB 250
2090 NEXT M:KT=TI+150
2100 REM WRONG FLAGS ARE CROSSED OUT
2110 IF FL=MN THEN 2140
2120 FOR J=W2+1 TO H*W2+W:IF SC%(J)=2 THEN IF VL%(J)<16 THEN GOSUB 2360
2130 NEXT J
2140 M$="{wht}B{rvon}OOM{rvof}! {grn}S{rvon}PACE {rvof}- {rvon}PLAY AGAIN  {rvof}Q - {rvon}MENU{rvof}":GOTO 2480
2150 REM ALL CLEAR: A FLAG GOES UP ON EVERY MINE WITH RISING NOTES (NO TILE
2160 REM BEHIND IT, SO THE GREEN SHOWS), A COLOUR WAVE RUNS OVER THE FLAGS
2170 REM (WHITE, YELLOW, GREEN), THEN THE FANFARE (TRIANGLE)
2180 GS=2:POKE 53269,0:N=0:POKE V3,0:POKE V3+6,246
2190 FOR M=1 TO MN:J=ML%(M):GOSUB 2270:NEXT M:FL=0:GOSUB 1530
2200 FOR N=0 TO 2:Z=9:IF N=1 THEN Z=15
2210 IF N=2 THEN Z=13
2220 FOR M=1 TO MN:J=ML%(M):A=AD%(J):IF BG THEN A=1024+40*A+XX%(J)
2230 POKE A+CM,Z:NEXT M,N
2240 POKE V3,0:POKE V3+6,248
2250 X=20:Y=8:GOSUB 2290:X=30:GOSUB 2290:X=45:Y=16:GOSUB 2290:KT=TI+60
2260 M$="{wht}Y{rvon}OU WIN{rvof}! {grn}S{rvon}PACE {rvof}- {rvon}PLAY AGAIN  {rvof}Q - {rvon}MENU{rvof}":GOTO 2480
2270 K=17:GOSUB 130:POKE V3+1,AR%(N AND 7):POKE V3+4,17:POKE V3+4,16:N=N+1
2280 RETURN
2290 POKE V3+1,X:POKE V3+4,17:TE=TI+Y
2300 IF TI<TE THEN 2300
2310 POKE V3+4,16:RETURN
2320 REM A CELL IN THE LAST COLUMN OR ROW: TILE (9), FLAG (10), WRONG FLAG (13)
2330 REM HAVE EDGE KINDS 18-26 (LAST COLUMN, LAST ROW, CORNER)
2340 E=-(XX%(J)=RX)-2*(J>HW):IF E THEN K=17+E+3*(K-9)+6*(K=13)
