3010 POKE 53269,1+AB:K$="":RETURN
3020 REM START: TABLES, SETTINGS, SPRITES, MUSIC
3030 REM PROGRAM AT $4001, MEMORY TOP $9000 BELOW THE MUSIC (AS HEX64, C64DOKU)
3040 DV=PEEK(186):IF DV<8 THEN DV=8
3050 REM VL MINES AROUND A CELL (+16 = IT IS A MINE), SC 0 COVERED / 1 OPEN /
3060 REM 2 FLAG, SK FLOOD FILL STACK, ML WHERE THE MINES ARE.
3070 REM THE BOARD HAS A BORDER OF OPEN CELLS, SO NO EDGE CHECKS ARE NEEDED
3080 REM BASIC FINDS A VARIABLE BY LOOKING THROUGH THEM IN THE ORDER THEY WERE
3090 REM MADE, SO THE BUSIEST ONES ARE MADE FIRST. CM = COLOUR RAM - SCREEN
3100 DIM J,K,A,BG,CM,N,P,SP,RV,M,I,V2,V3,V1,VF,VG,KT,MT,FT,FP,CX,CY,W2,QS,K$
3110 DIM ZS,VX,VY,VW,VH,AB
3120 DIM X,Y,Z,B,Q:CM=54272
3130 DIM SC%(511),VL%(511),SK%(511),DO%(7)
3140 DIM ML%(60),SX%(24),SM%(24),SY%(14)
3150 DIM FC%(7),DN$(3),BW%(3),BH%(3),BM%(3),TN$(1),SN$(3),BF%(5,2),SH%(5)
3160 DIM BD%(5),AR%(7),MC%(7),MK%(7)
3170 REM WHAT A CELL SHOWS (K): 0 EMPTY, 1-8 NUMBERS, 9 TILE, 10 FLAG, 11 BOMB,
3180 REM 12 CRATER, 13 WRONG FLAG, 14 PRESSED TILE, 15-16 POP, 17 FLAG WHEN YOU
3190 REM WIN; ITS CHARACTERS AND COLOURS ARE IN C64SWEEPERVIEW
3200 PRINT CHR$(147);CHR$(142);CHR$(8);:POKE 53280,0:POKE 53281,0:POKE 53272,30
3210 REM MULTICOLOUR CHARACTERS. STYLE SY: 0 CLASSIC, 1 BLUE, 2 OUTLINE (THE
3220 REM DEFAULT, AS THE MENU), 3 DASHED. THE NAMES ARE PADDED TO THE SAME WIDTH
3230 SY=PEEK(40712)-1:IF SY<0 OR SY>3 THEN SY=2
3240 SN$(0)="C{rvon}LASSIC{rvof}":SN$(1)="B{rvon}LUE{rvof}   ":SN$(2)="O{rvon}UTLINE{rvof}":SN$(3)="D{rvon}ASHED{rvof} "
3250 POKE 53270,PEEK(53270)OR 16:POKE 53282,12:GOSUB 2670
3260 BL$="":FOR I=1 TO 39:BL$=BL$+" ":NEXT I
3270 VB$="":FOR I=1 TO 5:VB$=VB$+CHR$(188):NEXT I:REM 5 EMPTY VOLUME NOTCHES
3280 TN$(0)="M{rvon}INES{rvof}":TN$(1)="M{rvon}INES {rvof}C{rvon}ALM{rvof}"
3290 DN$(1)="S{rvon}MALL{rvof}":DN$(2)="M{rvon}EDIUM{rvof}":DN$(3)="L{rvon}ARGE{rvof}"
3300 REM BOARDS: WIDTH, HEIGHT, MINES. SMALL AND MEDIUM HAVE BIG (2X2) CELLS
3310 FOR I=1 TO 3:READ BW%(I),BH%(I),BM%(I):NEXT I
3320 DATA 8,8,10,16,10,30,24,14,60
3330 REM MENU CELLS FOR THE CHOOSE A BOARD SCREEN: EMPTY, 1, 1, 1, 2, 2, 3, FLAG
3340 FOR I=0 TO 7:READ MC%(I),MK%(I):NEXT I
3350 DATA 64,6,65,1,65,1,65,1,66,7,66,7,67,2,74,10
3360 REM CURSOR FRAME PULSE: LIGHT BLUE, LIGHT GREY, WHITE, LIGHT GREY
3370 FOR I=0 TO 7:READ FC%(I):NEXT I
3380 DATA 14,15,1,1,1,15,14,14
3390 REM BLAST FRAMES: SPRITE COLOURS ($D025, $D026, SPRITE), SHAKE, BORDER
3400 FOR I=0 TO 5:READ BF%(I,0),BF%(I,1),BF%(I,2),SH%(I),BD%(I):NEXT I
3410 DATA 7,8,1,2,1,7,8,1,-2,7,7,8,1,2,8,7,8,2,-1,2,12,8,2,1,0,12,8,2,0,0
