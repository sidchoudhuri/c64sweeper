10 REM **** C64SWEEPER V3 GAME - MINESWEEPER IN C64 BASIC V2 ****
20 REM M0NDE.ITCH.IO - HTTPS://GITHUB.COM/SIDCHOUDHURI/C64SWEEPER
30 POKE 45,PEEK(174):POKE 46,PEEK(175):POKE 55,0:POKE 56,144:CLR
40 IF PEEK(40704)<>80 THEN PRINT CHR$(147);"RUN THE LOADER FIRST":END
50 REM PROGRAM AT $4001, MEMORY TOP $9000 (AS HEX64 AND C64DOKU)
60 DV=PEEK(186):IF DV<8 THEN DV=8
70 REM VL MINES AROUND A CELL, MI 1 = MINE, SC 0 COVERED / 1 OPEN / 2 FLAG,
80 REM AD SCREEN ADDRESS, SK FLOOD FILL STACK, ML WHERE THE MINES ARE.
90 REM THE BOARD HAS A BORDER OF OPEN CELLS, SO NO EDGE CHECKS ARE NEEDED
100 DIM VL%(415),MI%(415),SC%(415),AD%(415),SK%(415),ML%(60),DO%(7),CL%(8)
110 DIM SX%(24),SM%(24),SY%(14),FC%(7),DN$(3),BW%(3),BH%(3),BM%(3)
120 PRINT CHR$(147);CHR$(142);CHR$(8);:POKE 53280,0:POKE 53281,0:POKE 53272,30
130 BL$="":FOR I=1 TO 39:BL$=BL$+" ":NEXT I
140 VB$="":FOR I=1 TO 5:VB$=VB$+CHR$(188):NEXT I:REM 5 EMPTY VOLUME NOTCHES
150 DN$(1)="S{rvon}MALL{rvof}":DN$(2)="M{rvon}EDIUM{rvof}":DN$(3)="L{rvon}ARGE{rvof}"
160 REM BOARDS: WIDTH, HEIGHT, MINES
170 FOR I=1 TO 3:READ BW%(I),BH%(I),BM%(I):NEXT I
180 DATA 8,8,10,16,10,30,24,14,60
190 REM COLOURS OF AN EMPTY CELL AND THE NUMBERS 1-8
200 FOR I=0 TO 8:READ CL%(I):NEXT I
210 DATA 11,6,5,2,4,9,3,1,12
220 REM CURSOR FRAME PULSE: LIGHT BLUE, LIGHT GREY, WHITE, LIGHT GREY
230 FOR I=0 TO 7:READ FC%(I):NEXT I
240 DATA 14,15,1,1,1,15,14,14
250 S2=PEEK(40705):IF S2<>1 THEN S2=0
260 MV=PEEK(40706)-1:EV=PEEK(40707)-1:IF MV<0 OR MV>15 THEN MV=9
270 IF EV<0 OR EV>15 THEN EV=9
280 REM FX: TWO SIDS, $D420 VOICES 1-3; ONE SID, ALL ON VOICE 3
290 FS=54272+32*S2:V1=FS:V2=FS+7:V3=FS+14
300 IF S2=0 THEN EV=MV:V1=54286:V2=V1:V3=V1
310 POKE 54296,MV:IF S2 THEN POKE 54328,EV
320 REM PULSE WIDTH AND ATTACK/DECAY NEVER CHANGE, SO THEY ARE SET ONCE
330 POKE V1+2,0:POKE V1+3,8:POKE V1+5,0:POKE V2+5,0:POKE V3+5,0
340 GOSUB 1100
350 GOSUB 610:GOSUB 750
360 REM MAIN LOOP
370 GET K$:IF K$<>"" THEN 420
380 IF TI>=FT THEN FT=TI+8:FP=(FP+1)AND 7:POKE 53287,FC%(FP)
390 IF KT THEN IF TI>KT THEN POKE V1+4,0:POKE V2+4,0:POKE V3+4,0:KT=0
400 IF MT THEN IF TI>MT THEN M$="":GOSUB 1810
410 GOTO 370
420 IF K$="W" OR K$=CHR$(145) THEN GOSUB 1150:GOTO 370
430 IF K$="S" OR K$=CHR$(17) THEN GOSUB 1170:GOTO 370
440 IF K$="A" OR K$=CHR$(157) THEN GOSUB 1190:GOTO 370
450 IF K$="D" OR K$=CHR$(29) THEN GOSUB 1210:GOTO 370
460 IF K$=" " THEN GOSUB 1280:IF GS THEN 530
470 IF K$=CHR$(13) OR K$="F" THEN GOSUB 1710:GOTO 370
480 IF K$="V" THEN GOSUB 1890:GOTO 370
490 IF K$="I" THEN GOSUB 2020:GOTO 370
500 IF K$="Q" THEN GOSUB 1950:GOTO 370
510 GOTO 370
520 REM GAME OVER (WON OR LOST): SPACE PLAYS AGAIN, Q GOES TO THE MENU
530 TE=TI+45
540 IF TI<TE THEN 540
550 POKE 198,0
560 GET K$:IF K$=" " THEN 350
570 IF K$="Q" THEN 1980
580 IF KT THEN IF TI>KT THEN POKE V1+4,0:POKE V2+4,0:POKE V3+4,0:KT=0
590 GOTO 560
600 REM CHOOSE A BOARD
610 POKE 53269,0:PRINT "{clr}";:R=8:C=14:GOSUB 1830:PRINT "{wht}C64S{rvon}WEEPER {rvof}V3"
620 R=10:C=13:GOSUB 1830:PRINT "{grn}C{rvon}HOOSE A BOARD{rvof}"
630 R=12:C=6:GOSUB 1830:PRINT "{cyn}S {grn}- {wht}S{rvon}MALL   {grn}{rvof}8{rvon}X{rvof}8    10 {rvon}MINES{rvof}"
640 R=13:C=6:GOSUB 1830:PRINT "{cyn}M {grn}- {wht}M{rvon}EDIUM  {grn}{rvof}16{rvon}X{rvof}10  30 {rvon}MINES{rvof}"
650 R=14:C=6:GOSUB 1830:PRINT "{cyn}L {grn}- {wht}L{rvon}ARGE   {grn}{rvof}24{rvon}X{rvof}14  60 {rvon}MINES{rvof}"
660 R=16:C=6:GOSUB 1830:PRINT "{cyn}Q {grn}- {wht}B{rvon}ACK TO THE MENU{rvof}"
670 GET K$:IF K$="" THEN 670
680 SZ=0:IF K$="S" OR K$="1" THEN SZ=1
690 IF K$="M" OR K$="2" THEN SZ=2
700 IF K$="L" OR K$="3" THEN SZ=3
710 IF K$="Q" THEN 1980
720 IF SZ=0 THEN 670
730 W=BW%(SZ):H=BH%(SZ):MN=BM%(SZ):RETURN
740 REM NEW BOARD: THE TILES ARE DRAWN WHILE THE TABLES ARE FILLED
750 PRINT "{clr}";:GOSUB 1030
760 M$="{wht}C{rvon}REATING THE BOARD {rvof}...":GOSUB 1810
770 X=RND(-(TI*(PEEK(53266)+TI)))
780 W2=W+2:NC=W*H:TR=2+INT((21-H)/2):LC=INT((40-W)/2)
790 FOR I=0 TO (H+2)*W2-1:VL%(I)=0:MI%(I)=0:SC%(I)=1:NEXT I
800 REM FRAME: TOP AND BOTTOM LINES, THEN THE SIDES ROW BY ROW WITH THE TILES
810 A=1024+40*(TR-1)+LC-1:J=A+40*(H+1):K=W+1
820 FOR C=1 TO W:POKE A+C+54272,11:POKE A+C,79
830 POKE J+C+54272,11:POKE J+C,79:NEXT C
840 POKE A+54272,11:POKE A,78:POKE A+K+54272,11:POKE A+K,80
850 POKE J+54272,11:POKE J,82:POKE J+K+54272,11:POKE J+K,83
860 FOR R=1 TO H:A=1024+40*(TR+R-1)+LC-1:J=R*W2:SY%(R)=49+8*(TR+R-1)
870 POKE A+54272,11:POKE A,81:POKE A+K+54272,11:POKE A+K,81
880 FOR C=1 TO W:AD%(J+C)=A+C:SC%(J+C)=0:POKE A+C+54272,12:POKE A+C,73
890 NEXT C,R
900 REM CURSOR SPRITE X FOR EVERY COLUMN (SM = 1 PAST X 255)
910 FOR C=1 TO W:X=23+8*(LC+C-1):SM%(C)=-(X>255):SX%(C)=X AND 255:NEXT C
920 REM THE 8 CELLS AROUND A CELL
930 DO%(0)=-W2-1:DO%(1)=-W2:DO%(2)=1-W2:DO%(3)=-1
940 DO%(4)=1:DO%(5)=W2-1:DO%(6)=W2:DO%(7)=W2+1
950 REM MINES: EACH ONE ADDS 1 TO THE 8 CELLS AROUND IT
960 FOR K=1 TO MN
970 P=(INT(RND(1)*H)+1)*W2+INT(RND(1)*W)+1:IF MI%(P) THEN 970
980 MI%(P)=1:ML%(K)=P:FOR N=0 TO 7:J=P+DO%(N):VL%(J)=VL%(J)+1:NEXT N,K
990 REM FL FLAGS LEFT, RV CELLS OPEN, FR FIRST REVEAL, I THE CURSOR CELL
1000 FL=MN:RV=0:GS=0:FR=1:CX=1:CY=1:I=W2+1
1010 M$="":GOSUB 1810:GOSUB 1080:POKE 198,0:GOTO 1250
1020 REM HEADER ROWS 0-1
1030 R=0:C=2:GOSUB 1830:PRINT "{wht}C64S{rvon}WEEPER {rvof}V3  {grn}";DN$(SZ);
1040 C=27:GOSUB 1830:PRINT "{grn}M{rvon}INES{rvof}";
1050 R=1:C=1:GOSUB 1830:PRINT "{cyn}S{rvon}PACE {grn}{rvof}R{rvon}EVEAL {cyn}{rvof}R{rvon}ETURN {grn}{rvof}F{rvon}LAG {rvof}";
1060 PRINT "{cyn}I {grn}H{rvon}ELP {cyn}{rvof}Q {grn}M{rvon}ENU{rvof}";:RETURN
1070 REM FLAGS LEFT
1080 R=0:C=33:GOSUB 1830:PRINT "{wht}";RIGHT$(" "+MID$(STR$(FL),2),2);:RETURN
1090 REM SPRITE 0: A 10X10 OUTLINE AROUND THE CURSOR CELL (BLOCK 13 AT 832)
1100 FOR I=0 TO 62:POKE 832+I,0:NEXT I
1110 FOR I=1 TO 8:POKE 832+3*I,128:POKE 833+3*I,64:NEXT I
1120 FOR I=0 TO 1:POKE 832+27*I,255:POKE 833+27*I,192:NEXT I
1130 POKE 2040,13:POKE 53287,14:POKE 53276,0:POKE 53277,0:POKE 53271,0:RETURN
1140 REM MOVING: AT AN EDGE NOTHING MOVES AND THE KEYBOARD BUFFER IS CLEARED
1150 IF CY=1 THEN POKE 198,0:RETURN
1160 CY=CY-1:I=I-W2:GOTO 1240
1170 IF CY=H THEN POKE 198,0:RETURN
1180 CY=CY+1:I=I+W2:GOTO 1240
1190 IF CX=1 THEN POKE 198,0:RETURN
1200 CX=CX-1:I=I-1:GOTO 1240
1210 IF CX=W THEN POKE 198,0:RETURN
1220 CX=CX+1:I=I+1
1230 REM TICK (PULSE), THEN THE CURSOR SPRITE GOES TO CELL CX,CY
1240 POKE V1,0:POKE V1+1,35:POKE V1+6,243:POKE V1+4,65:POKE V1+4,64:KT=TI+60
1250 POKE 53248,SX%(CX):POKE 53264,SM%(CX):POKE 53249,SY%(CY)
1260 POKE 53287,1:POKE 53269,1:FP=2:FT=TI+8:RETURN
1270 REM REVEAL THE CURSOR CELL. THE FIRST REVEAL IS ALWAYS SAFE
1280 IF SC%(I) THEN RETURN
1290 IF FR THEN FR=0:IF MI%(I) THEN GOSUB 1470
1300 IF MI%(I) THEN 1530
1310 REM CLICK (TRIANGLE)
1320 POKE V2,0:POKE V2+1,20:POKE V2+6,248:POKE V2+4,17:POKE V2+4,16:KT=TI+60
1330 SC%(I)=1:RV=RV+1:V=VL%(I):POKE AD%(I)+54272,CL%(V):POKE AD%(I),64+V
1340 IF V=0 THEN GOSUB 1390
1350 IF RV=NC-MN THEN 1620
1360 RETURN
1370 REM FLOOD FILL FROM AN EMPTY CELL: OPEN CELLS AND FLAGS ARE LEFT ALONE,
1380 REM ONLY THE CELLS THAT CHANGE ARE DRAWN
1390 SP=1:SK%(0)=I
1400 IF SP=0 THEN RETURN
1410 SP=SP-1:P=SK%(SP):FOR N=0 TO 7:J=P+DO%(N):IF SC%(J) THEN 1440
1420 SC%(J)=1:RV=RV+1:V=VL%(J):A=AD%(J):POKE A+54272,CL%(V):POKE A,64+V
1430 IF V=0 THEN SK%(SP)=J:SP=SP+1
1440 NEXT N:GOTO 1400
1450 REM THE FIRST REVEAL HIT A MINE: THE MINE MOVES TO A FREE CELL AND ONLY
1460 REM THE COUNTS AROUND THE TWO CELLS CHANGE
1470 J=(INT(RND(1)*H)+1)*W2+INT(RND(1)*W)+1:IF MI%(J) THEN 1470
1480 MI%(I)=0:MI%(J)=1:FOR N=0 TO 7:A=I+DO%(N):VL%(A)=VL%(A)-1
1490 A=J+DO%(N):VL%(A)=VL%(A)+1:NEXT N
1500 FOR K=1 TO MN:IF ML%(K)=I THEN ML%(K)=J
1510 NEXT K:RETURN
1520 REM A MINE: BOOM (NOISE), ALL MINES SHOW, WRONG FLAGS ARE CROSSED OUT
1530 GS=1:POKE 53269,0
1540 POKE V3,10:POKE V3+1,5:POKE V3+6,220:POKE V3+4,129:POKE V3+4,128:KT=TI+150
1550 FOR K=1 TO MN:J=ML%(K):IF SC%(J)=0 THEN POKE AD%(J)+54272,2:POKE AD%(J),75
1560 NEXT K:POKE AD%(I)+54272,10:POKE AD%(I),76
1570 IF FL=MN THEN 1600
1580 FOR J=W2+1 TO H*W2+W:IF SC%(J)=2 THEN IF MI%(J)=0 THEN POKE AD%(J),77
1590 NEXT J
1600 M$="{wht}B{rvon}OOM{rvof}! {grn}S{rvon}PACE {rvof}- {rvon}PLAY AGAIN  {rvof}Q - {rvon}MENU{rvof}":GOTO 1810
1610 REM ALL CLEAR: THE MINES ARE FLAGGED IN GREEN, FANFARE (TRIANGLE)
1620 GS=2:POKE 53269,0
1630 FOR K=1 TO MN:J=ML%(K):POKE AD%(J)+54272,5:POKE AD%(J),74:NEXT K
1640 FL=0:GOSUB 1080:POKE V3,0:POKE V3+6,248
1650 X=20:Y=8:GOSUB 1670:X=30:GOSUB 1670:X=45:Y=16:GOSUB 1670:KT=TI+60
1660 M$="{wht}Y{rvon}OU WIN{rvof}! {grn}S{rvon}PACE {rvof}- {rvon}PLAY AGAIN  {rvof}Q - {rvon}MENU{rvof}":GOTO 1810
1670 POKE V3+1,X:POKE V3+4,17:TE=TI+Y
1680 IF TI<TE THEN 1680
1690 POKE V3+4,16:RETURN
1700 REM FLAG OR UNFLAG THE CURSOR CELL
1710 IF SC%(I)=1 THEN RETURN
1720 IF SC%(I)=0 THEN 1740
1730 SC%(I)=0:FL=FL+1:POKE AD%(I)+54272,12:POKE AD%(I),73:GOTO 1760
1740 IF FL=0 THEN RETURN
1750 SC%(I)=2:FL=FL-1:POKE AD%(I)+54272,7:POKE AD%(I),74
1760 GOSUB 1780:GOTO 1080
1770 REM BEEP (SAWTOOTH)
1780 POKE V2,100:POKE V2+1,10:POKE V2+6,240:POKE V2+4,33:POKE V2+4,32:KT=TI+60
1790 RETURN
1800 REM STATUS LINE (ROW 23): M$, CENTRED
1810 MT=0:GOSUB 1850:R=23:C=0:GOSUB 1830:PRINT BL$;
1820 C=INT((40-N)/2):GOSUB 1830:PRINT M$;:RETURN
1830 POKE 214,R:POKE 211,C:SYS 58732:RETURN
1840 REM N = HOW MANY CHARACTERS OF M$ SHOW (NOT COUNTING CONTROL CODES)
1850 N=0:IF M$="" THEN RETURN
1860 FOR K=1 TO LEN(M$):A=ASC(MID$(M$,K,1))
1870 N=N-((A>31 AND A<128) OR A>159):NEXT K:RETURN
1880 REM V: THE NEXT VOLUME STEP; THE BAR GOES AFTER 2 SECONDS
1890 IF S2=0 THEN MV=(MV+3)*-(MV<15):EV=MV:POKE 54296,MV
1900 IF S2 THEN EV=(EV+3)*-(EV<15):POKE 54328,EV
1910 POKE 40706,MV+1:POKE 40707,EV+1:X=INT(EV/3+.5)
1920 M$="{wht}V{rvon}OLUME{rvof} "+CHR$(18)+LEFT$("]]]]]",X)+CHR$(146)+LEFT$(VB$,5-X)
1930 GOSUB 1810:MT=TI+120:GOTO 1780
1940 REM BACK TO THE LOADER (ASKS FIRST)
1950 M$="{wht}Q{rvon}UIT TO THE MENU{rvof}? Y/N":GOSUB 1810
1960 GET K$:IF K$="" THEN 1960
1970 IF K$<>"Y" THEN M$="":GOTO 1810
1980 POKE V1+4,0:POKE V2+4,0:POKE V3+4,0:POKE 40709,82:POKE 53269,0
1990 PRINT "{clr}{wht}L{rvon}OADING {rvof}C64S{rvon}WEEPER {rvof}...":LOAD"C64SWEEPER",DV
2000 REM I: INSTRUCTIONS. SAVE THE SCREEN AT $2400, SHOW C64SWEEPERHELP ($2C00),
2010 REM ANY KEY PUTS THE BOARD BACK; SYS 13312 COPIES 4 PAGES (A FROM, Y TO)
2020 POKE 53269,0:POKE 780,4:POKE 782,36:SYS 13312
2030 POKE 780,216:POKE 782,40:SYS 13312
2040 POKE 780,44:POKE 782,4:SYS 13312:POKE 780,48:POKE 782,216:SYS 13312
2050 POKE 198,0
2060 GET K$:IF K$="" THEN 2060
2070 POKE 780,36:POKE 782,4:SYS 13312:POKE 780,40:POKE 782,216:SYS 13312
2080 POKE 53269,1:K$="":RETURN
