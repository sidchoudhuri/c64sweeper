3430 FOR I=0 TO 7:READ AR%(I):NEXT I
3440 DATA 19,23,25,29,34,39,46,51
3450 S2=PEEK(40705):IF S2<>1 THEN S2=0
3460 MV=PEEK(40706)-1:EV=PEEK(40707)-1:IF MV<0 OR MV>15 THEN MV=9
3470 IF EV<0 OR EV>15 THEN EV=9
3480 REM FX: TWO SIDS, $D420 VOICES 1-3; ONE SID, ALL ON VOICE 3
3490 FS=54272+32*S2:V1=FS:V2=FS+7:V3=FS+14
3500 IF S2=0 THEN EV=MV:V1=54286:V2=V1:V3=V1
3510 POKE 54296,MV:IF S2 THEN POKE 54328,EV
3520 REM PULSE WIDTH AND ATTACK/DECAY NEVER CHANGE, SO THEY ARE SET ONCE
3530 POKE V1+2,0:POKE V1+3,8:POKE V1+5,0:POKE V2+5,0:POKE V3+5,0:VF=V3+1:VG=V3+4
