10 REM **** C64SWEEPER V4 GAME - MINESWEEPER IN C64 BASIC V2 ****
20 REM M0NDE.ITCH.IO - HTTPS://GITHUB.COM/SIDCHOUDHURI/C64SWEEPER
30 POKE 45,PEEK(174):POKE 46,PEEK(175):POKE 55,0:POKE 56,144:CLR
40 IF PEEK(40704)<>80 THEN PRINT CHR$(147);"RUN THE LOADER FIRST":END
50 REM PROGRAM AT $4001, MEMORY TOP $9000 BELOW THE MUSIC (AS HEX64 AND C64DOKU)
60 DV=PEEK(186):IF DV<8 THEN DV=8
70 REM VL MINES AROUND A CELL, MI 1 = MINE, SC 0 COVERED / 1 OPEN / 2 FLAG,
80 REM AD SCREEN ADDRESS, SK FLOOD FILL STACK, ML WHERE THE MINES ARE.
90 REM THE BOARD HAS A BORDER OF OPEN CELLS, SO NO EDGE CHECKS ARE NEEDED
100 DIM VL%(415),MI%(415),SC%(415),AD%(415),SK%(415),ML%(60),DO%(7),CL%(8)
110 DIM SX%(24),SM%(24),SY%(14),FC%(7),DN$(3),BW%(3),BH%(3),BM%(3),TN$(1)
120 PRINT CHR$(147);CHR$(142);CHR$(8);:POKE 53280,0:POKE 53281,0:POKE 53272,30
130 BL$="":FOR I=1 TO 39:BL$=BL$+" ":NEXT I
140 VB$="":FOR I=1 TO 5:VB$=VB$+CHR$(188):NEXT I:REM 5 EMPTY VOLUME NOTCHES
150 TN$(0)="M{rvon}INES{rvof}":TN$(1)="M{rvon}INES {rvof}C{rvon}ALM{rvof}"
160 DN$(1)="S{rvon}MALL{rvof}":DN$(2)="M{rvon}EDIUM{rvof}":DN$(3)="L{rvon}ARGE{rvof}"
170 REM BOARDS: WIDTH, HEIGHT, MINES
180 FOR I=1 TO 3:READ BW%(I),BH%(I),BM%(I):NEXT I
190 DATA 8,8,10,16,10,30,24,14,60
200 REM COLOURS OF AN EMPTY CELL AND THE NUMBERS 1-8
210 FOR I=0 TO 8:READ CL%(I):NEXT I
220 DATA 11,6,5,2,4,9,3,1,12
230 REM CURSOR FRAME PULSE: LIGHT BLUE, LIGHT GREY, WHITE, LIGHT GREY
240 FOR I=0 TO 7:READ FC%(I):NEXT I
250 DATA 14,15,1,1,1,15,14,14
260 S2=PEEK(40705):IF S2<>1 THEN S2=0
270 MV=PEEK(40706)-1:EV=PEEK(40707)-1:IF MV<0 OR MV>15 THEN MV=9
280 IF EV<0 OR EV>15 THEN EV=9
290 REM FX: TWO SIDS, $D420 VOICES 1-3; ONE SID, ALL ON VOICE 3
300 FS=54272+32*S2:V1=FS:V2=FS+7:V3=FS+14
310 IF S2=0 THEN EV=MV:V1=54286:V2=V1:V3=V1
320 POKE 54296,MV:IF S2 THEN POKE 54328,EV
330 REM PULSE WIDTH AND ATTACK/DECAY NEVER CHANGE, SO THEY ARE SET ONCE
340 POKE V1+2,0:POKE V1+3,8:POKE V1+5,0:POKE V2+5,0:POKE V3+5,0
350 SG=PEEK(40711)-1:IF SG<0 OR SG>1 THEN SG=1:REM 0 MINES, 1 MINES CALM
360 GOSUB 1140
370 POKE 36871,SG:POKE 36879,MV:POKE 36870,S2:SYS 36864:REM MUSIC
380 GOSUB 650:GOSUB 790
390 REM MAIN LOOP
400 GET K$:IF K$<>"" THEN 450
410 IF TI>=FT THEN FT=TI+8:FP=(FP+1)AND 7:POKE 53287,FC%(FP)
420 IF KT THEN IF TI>KT THEN POKE V1+4,0:POKE V2+4,0:POKE V3+4,0:KT=0
430 IF MT THEN IF TI>MT THEN M$="":GOSUB 1850
440 GOTO 400
450 IF K$="W" OR K$=CHR$(145) THEN GOSUB 1190:GOTO 400
460 IF K$="S" OR K$=CHR$(17) THEN GOSUB 1210:GOTO 400
470 IF K$="A" OR K$=CHR$(157) THEN GOSUB 1230:GOTO 400
480 IF K$="D" OR K$=CHR$(29) THEN GOSUB 1250:GOTO 400
490 IF K$=" " THEN GOSUB 1320:IF GS THEN 570
500 IF K$=CHR$(13) OR K$="F" THEN GOSUB 1750:GOTO 400
510 IF K$="M" OR K$="E" OR K$="V" THEN GOSUB 1960:GOTO 400
520 IF K$="T" THEN GOSUB 1930:GOTO 400
530 IF K$="I" THEN GOSUB 2160:GOTO 400
540 IF K$="Q" THEN GOSUB 2090:GOTO 400
550 GOTO 400
560 REM GAME OVER (WON OR LOST): SPACE PLAYS AGAIN, Q GOES TO THE MENU
570 TE=TI+45
580 IF TI<TE THEN 580
590 POKE 198,0
600 GET K$:IF K$=" " THEN 380
610 IF K$="Q" THEN 2120
620 IF KT THEN IF TI>KT THEN POKE V1+4,0:POKE V2+4,0:POKE V3+4,0:KT=0
630 GOTO 600
640 REM CHOOSE A BOARD
650 POKE 53269,0:PRINT "{clr}";:R=8:C=14:GOSUB 1870:PRINT "{wht}C64S{rvon}WEEPER {rvof}V4"
660 R=10:C=13:GOSUB 1870:PRINT "{grn}C{rvon}HOOSE A BOARD{rvof}"
670 R=12:C=6:GOSUB 1870:PRINT "{cyn}S {grn}- {wht}S{rvon}MALL   {grn}{rvof}8{rvon}X{rvof}8    10 {rvon}MINES{rvof}"
680 R=13:C=6:GOSUB 1870:PRINT "{cyn}M {grn}- {wht}M{rvon}EDIUM  {grn}{rvof}16{rvon}X{rvof}10  30 {rvon}MINES{rvof}"
690 R=14:C=6:GOSUB 1870:PRINT "{cyn}L {grn}- {wht}L{rvon}ARGE   {grn}{rvof}24{rvon}X{rvof}14  60 {rvon}MINES{rvof}"
700 R=16:C=6:GOSUB 1870:PRINT "{cyn}Q {grn}- {wht}B{rvon}ACK TO THE MENU{rvof}"
710 GET K$:IF K$="" THEN 710
720 SZ=0:IF K$="S" OR K$="1" THEN SZ=1
730 IF K$="M" OR K$="2" THEN SZ=2
740 IF K$="L" OR K$="3" THEN SZ=3
750 IF K$="Q" THEN 2120
760 IF SZ=0 THEN 710
770 W=BW%(SZ):H=BH%(SZ):MN=BM%(SZ):RETURN
780 REM NEW BOARD: THE TILES ARE DRAWN WHILE THE TABLES ARE FILLED
790 PRINT "{clr}";:GOSUB 1070
800 M$="{wht}C{rvon}REATING THE BOARD {rvof}...":GOSUB 1850
810 X=RND(-(TI*(PEEK(53266)+TI)))
820 W2=W+2:NC=W*H:TR=2+INT((21-H)/2):LC=INT((40-W)/2)
830 FOR I=0 TO (H+2)*W2-1:VL%(I)=0:MI%(I)=0:SC%(I)=1:NEXT I
840 REM FRAME: TOP AND BOTTOM LINES, THEN THE SIDES ROW BY ROW WITH THE TILES
850 A=1024+40*(TR-1)+LC-1:J=A+40*(H+1):K=W+1
860 FOR C=1 TO W:POKE A+C+54272,11:POKE A+C,79
870 POKE J+C+54272,11:POKE J+C,79:NEXT C
880 POKE A+54272,11:POKE A,78:POKE A+K+54272,11:POKE A+K,80
890 POKE J+54272,11:POKE J,82:POKE J+K+54272,11:POKE J+K,83
900 FOR R=1 TO H:A=1024+40*(TR+R-1)+LC-1:J=R*W2:SY%(R)=49+8*(TR+R-1)
910 POKE A+54272,11:POKE A,81:POKE A+K+54272,11:POKE A+K,81
920 FOR C=1 TO W:AD%(J+C)=A+C:SC%(J+C)=0:POKE A+C+54272,12:POKE A+C,73
930 NEXT C,R
940 REM CURSOR SPRITE X FOR EVERY COLUMN (SM = 1 PAST X 255)
950 FOR C=1 TO W:X=23+8*(LC+C-1):SM%(C)=-(X>255):SX%(C)=X AND 255:NEXT C
960 REM THE 8 CELLS AROUND A CELL
970 DO%(0)=-W2-1:DO%(1)=-W2:DO%(2)=1-W2:DO%(3)=-1
980 DO%(4)=1:DO%(5)=W2-1:DO%(6)=W2:DO%(7)=W2+1
990 REM MINES: EACH ONE ADDS 1 TO THE 8 CELLS AROUND IT
1000 FOR K=1 TO MN
1010 P=(INT(RND(1)*H)+1)*W2+INT(RND(1)*W)+1:IF MI%(P) THEN 1010
1020 MI%(P)=1:ML%(K)=P:FOR N=0 TO 7:J=P+DO%(N):VL%(J)=VL%(J)+1:NEXT N,K
1030 REM FL FLAGS LEFT, RV CELLS OPEN, FR FIRST REVEAL, I THE CURSOR CELL
1040 FL=MN:RV=0:GS=0:FR=1:CX=1:CY=1:I=W2+1
1050 M$="":GOSUB 1850:GOSUB 1120:POKE 198,0:GOTO 1290
1060 REM HEADER ROWS 0-1
1070 R=0:C=2:GOSUB 1870:PRINT "{wht}C64S{rvon}WEEPER {rvof}V4  {grn}";DN$(SZ);
1080 C=27:GOSUB 1870:PRINT "{grn}M{rvon}INES{rvof}";
1090 R=1:C=1:GOSUB 1870:PRINT "{cyn}S{rvon}PACE {grn}{rvof}R{rvon}EVEAL {cyn}{rvof}R{rvon}ETURN {grn}{rvof}F{rvon}LAG {rvof}";
1100 PRINT "{cyn}I {grn}H{rvon}ELP {cyn}{rvof}Q {grn}M{rvon}ENU{rvof}";:RETURN
1110 REM FLAGS LEFT
1120 R=0:C=33:GOSUB 1870:PRINT "{wht}";RIGHT$(" "+MID$(STR$(FL),2),2);:RETURN
1130 REM SPRITE 0: A 10X10 OUTLINE AROUND THE CURSOR CELL (BLOCK 13 AT 832)
1140 FOR I=0 TO 62:POKE 832+I,0:NEXT I
1150 FOR I=1 TO 8:POKE 832+3*I,128:POKE 833+3*I,64:NEXT I
1160 FOR I=0 TO 1:POKE 832+27*I,255:POKE 833+27*I,192:NEXT I
1170 POKE 2040,13:POKE 53287,14:POKE 53276,0:POKE 53277,0:POKE 53271,0:RETURN
1180 REM MOVING: AT AN EDGE NOTHING MOVES AND THE KEYBOARD BUFFER IS CLEARED
1190 IF CY=1 THEN POKE 198,0:RETURN
1200 CY=CY-1:I=I-W2:GOTO 1280
1210 IF CY=H THEN POKE 198,0:RETURN
1220 CY=CY+1:I=I+W2:GOTO 1280
1230 IF CX=1 THEN POKE 198,0:RETURN
1240 CX=CX-1:I=I-1:GOTO 1280
1250 IF CX=W THEN POKE 198,0:RETURN
1260 CX=CX+1:I=I+1
1270 REM TICK (PULSE), THEN THE CURSOR SPRITE GOES TO CELL CX,CY
1280 POKE V1,0:POKE V1+1,35:POKE V1+6,243:POKE V1+4,65:POKE V1+4,64:KT=TI+60
1290 POKE 53248,SX%(CX):POKE 53264,SM%(CX):POKE 53249,SY%(CY)
1300 POKE 53287,1:POKE 53269,1:FP=2:FT=TI+8:RETURN
1310 REM REVEAL THE CURSOR CELL. THE FIRST REVEAL IS ALWAYS SAFE
1320 IF SC%(I) THEN RETURN
1330 IF FR THEN FR=0:IF MI%(I) THEN GOSUB 1510
1340 IF MI%(I) THEN 1570
1350 REM CLICK (TRIANGLE)
1360 POKE V2,0:POKE V2+1,20:POKE V2+6,248:POKE V2+4,17:POKE V2+4,16:KT=TI+60
1370 SC%(I)=1:RV=RV+1:V=VL%(I):POKE AD%(I)+54272,CL%(V):POKE AD%(I),64+V
1380 IF V=0 THEN GOSUB 1430
1390 IF RV=NC-MN THEN 1660
1400 RETURN
1410 REM FLOOD FILL FROM AN EMPTY CELL: OPEN CELLS AND FLAGS ARE LEFT ALONE,
1420 REM ONLY THE CELLS THAT CHANGE ARE DRAWN
1430 SP=1:SK%(0)=I
1440 IF SP=0 THEN RETURN
1450 SP=SP-1:P=SK%(SP):FOR N=0 TO 7:J=P+DO%(N):IF SC%(J) THEN 1480
1460 SC%(J)=1:RV=RV+1:V=VL%(J):A=AD%(J):POKE A+54272,CL%(V):POKE A,64+V
1470 IF V=0 THEN SK%(SP)=J:SP=SP+1
1480 NEXT N:GOTO 1440
1490 REM THE FIRST REVEAL HIT A MINE: THE MINE MOVES TO A FREE CELL AND ONLY
1500 REM THE COUNTS AROUND THE TWO CELLS CHANGE
1510 J=(INT(RND(1)*H)+1)*W2+INT(RND(1)*W)+1:IF MI%(J) THEN 1510
1520 MI%(I)=0:MI%(J)=1:FOR N=0 TO 7:A=I+DO%(N):VL%(A)=VL%(A)-1
1530 A=J+DO%(N):VL%(A)=VL%(A)+1:NEXT N
1540 FOR K=1 TO MN:IF ML%(K)=I THEN ML%(K)=J
1550 NEXT K:RETURN
1560 REM A MINE: BOOM (NOISE), ALL MINES SHOW, WRONG FLAGS ARE CROSSED OUT
1570 GS=1:POKE 53269,0
1580 POKE V3,10:POKE V3+1,5:POKE V3+6,220:POKE V3+4,129:POKE V3+4,128:KT=TI+150
1590 FOR K=1 TO MN:J=ML%(K):IF SC%(J)=0 THEN POKE AD%(J)+54272,2:POKE AD%(J),75
1600 NEXT K:POKE AD%(I)+54272,10:POKE AD%(I),76
1610 IF FL=MN THEN 1640
1620 FOR J=W2+1 TO H*W2+W:IF SC%(J)=2 THEN IF MI%(J)=0 THEN POKE AD%(J),77
1630 NEXT J
1640 M$="{wht}B{rvon}OOM{rvof}! {grn}S{rvon}PACE {rvof}- {rvon}PLAY AGAIN  {rvof}Q - {rvon}MENU{rvof}":GOTO 1850
1650 REM ALL CLEAR: THE MINES ARE FLAGGED IN GREEN, FANFARE (TRIANGLE)
1660 GS=2:POKE 53269,0
1670 FOR K=1 TO MN:J=ML%(K):POKE AD%(J)+54272,5:POKE AD%(J),74:NEXT K
1680 FL=0:GOSUB 1120:POKE V3,0:POKE V3+6,248
1690 X=20:Y=8:GOSUB 1710:X=30:GOSUB 1710:X=45:Y=16:GOSUB 1710:KT=TI+60
1700 M$="{wht}Y{rvon}OU WIN{rvof}! {grn}S{rvon}PACE {rvof}- {rvon}PLAY AGAIN  {rvof}Q - {rvon}MENU{rvof}":GOTO 1850
1710 POKE V3+1,X:POKE V3+4,17:TE=TI+Y
1720 IF TI<TE THEN 1720
1730 POKE V3+4,16:RETURN
1740 REM FLAG OR UNFLAG THE CURSOR CELL
1750 IF SC%(I)=1 THEN RETURN
1760 IF SC%(I)=0 THEN 1780
1770 SC%(I)=0:FL=FL+1:POKE AD%(I)+54272,12:POKE AD%(I),73:GOTO 1800
1780 IF FL=0 THEN RETURN
1790 SC%(I)=2:FL=FL-1:POKE AD%(I)+54272,7:POKE AD%(I),74
1800 GOSUB 1820:GOTO 1120
1810 REM BEEP (SAWTOOTH)
1820 POKE V2,100:POKE V2+1,10:POKE V2+6,240:POKE V2+4,33:POKE V2+4,32:KT=TI+60
1830 RETURN
1840 REM STATUS LINE (ROW 23): M$, CENTRED
1850 MT=0:GOSUB 1890:R=23:C=0:GOSUB 1870:PRINT BL$;
1860 C=INT((40-N)/2):GOSUB 1870:PRINT M$;:RETURN
1870 POKE 214,R:POKE 211,C:SYS 58732:RETURN
1880 REM N = HOW MANY CHARACTERS OF M$ SHOW (NOT COUNTING CONTROL CODES)
1890 N=0:IF M$="" THEN RETURN
1900 FOR K=1 TO LEN(M$):A=ASC(MID$(M$,K,1))
1910 N=N-((A>31 AND A<128) OR A>159):NEXT K:RETURN
1920 REM T: THE OTHER TUNE, NAMED ON THE STATUS LINE FOR 2 SECONDS
1930 SG=1-SG:POKE 40711,SG+1:SYS 36867:POKE 36871,SG:SYS 36864
1940 M$="{wht}M{rvon}USIC{rvof}: "+TN$(SG):GOSUB 1850:MT=TI+120:RETURN
1950 REM VOLUME KEYS: M / E WITH TWO SIDS, V WITH ONE
1960 IF S2=0 AND K$<>"V" THEN RETURN
1970 IF S2 AND K$="V" THEN RETURN
1980 IF K$="M" THEN MV=(MV+3)*-(MV<15):POKE 54296,MV:POKE 36879,MV
1990 IF K$="M" THEN POKE 40706,MV+1
2000 IF K$="E" THEN EV=(EV+3)*-(EV<15):POKE 54328,EV:POKE 40707,EV+1
2010 IF K$="V" THEN MV=(MV+3)*-(MV<15):EV=MV:POKE 54296,MV:POKE 36879,MV
2020 IF K$="V" THEN POKE 40706,MV+1:POKE 40707,EV+1
2030 X=MV:N$="M{rvon}USIC{rvof}":IF K$="E" THEN X=EV:N$="S{rvon}OUND{rvof} FX"
2040 IF K$="V" THEN N$="V{rvon}OLUME{rvof}"
2050 X=INT(X/3+.5):M$="{wht}"+N$+" "+CHR$(18)+LEFT$("]]]]]",X)
2060 M$=M$+CHR$(146)+LEFT$(VB$,5-X)
2070 GOSUB 1850:MT=TI+120:RETURN:REM THE VOLUME BAR GOES AFTER 2 SECONDS
2080 REM BACK TO THE LOADER (ASKS FIRST)
2090 M$="{wht}Q{rvon}UIT TO THE MENU{rvof}? Y/N":GOSUB 1850
2100 GET K$:IF K$="" THEN 2100
2110 IF K$<>"Y" THEN M$="":GOTO 1850
2120 SYS 36867:POKE V1+4,0:POKE V2+4,0:POKE V3+4,0:POKE 40709,82:POKE 53269,0
2130 PRINT "{clr}{wht}L{rvon}OADING {rvof}C64S{rvon}WEEPER {rvof}...":LOAD"C64SWEEPER",DV
2140 REM I: INSTRUCTIONS. SAVE THE SCREEN AT $2400, SHOW C64SWEEPERHELP ($2C00),
2150 REM ANY KEY PUTS THE BOARD BACK; SYS 13312 COPIES 4 PAGES (A FROM, Y TO)
2160 POKE 53269,0:POKE 780,4:POKE 782,36:SYS 13312
2170 POKE 780,216:POKE 782,40:SYS 13312
2180 POKE 780,44:POKE 782,4:SYS 13312:POKE 780,48:POKE 782,216:SYS 13312
2190 POKE 198,0
2200 GET K$:IF K$="" THEN 2200
2210 POKE 780,36:POKE 782,4:SYS 13312:POKE 780,40:POKE 782,216:SYS 13312
2220 POKE 53269,1:K$="":RETURN
