2730 M$="{wht}M{rvon}USIC{rvof}: "+TN$(SG):GOSUB 2570:MT=TI+120:RETURN
2740 REM VOLUME KEYS: M / E WITH TWO SIDS, V WITH ONE
2750 IF S2=0 AND K$<>"V" THEN RETURN
2760 IF S2 AND K$="V" THEN RETURN
2770 IF K$="M" THEN MV=(MV+3)*-(MV<15):POKE 54296,MV:POKE 36879,MV
2780 IF K$="M" THEN POKE 40706,MV+1
2790 IF K$="E" THEN EV=(EV+3)*-(EV<15):POKE 54328,EV:POKE 40707,EV+1
2800 IF K$="V" THEN MV=(MV+3)*-(MV<15):EV=MV:POKE 54296,MV:POKE 36879,MV
2810 IF K$="V" THEN POKE 40706,MV+1:POKE 40707,EV+1
2820 X=MV:N$="M{rvon}USIC{rvof}":IF K$="E" THEN X=EV:N$="S{rvon}OUND{rvof} FX"
2830 IF K$="V" THEN N$="V{rvon}OLUME{rvof}"
2840 X=INT(X/3+.5):M$="{wht}"+N$+" "+CHR$(18)+LEFT$("]]]]]",X)
2850 M$=M$+CHR$(146)+LEFT$(VB$,5-X)
