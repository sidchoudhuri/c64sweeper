2870 REM BACK TO THE LOADER (ASKS FIRST)
2880 M$="{wht}Q{rvon}UIT TO THE MENU{rvof}? Y/N":GOSUB 2570
2890 GET K$:IF K$="" THEN 2890
2900 IF K$<>"Y" THEN M$="":GOTO 2570
