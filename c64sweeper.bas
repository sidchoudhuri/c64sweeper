0 REM C64SWEEPER - SPEED-OPTIMIZED BASIC V2 MINESWEEPER
1 REM USES {TOKEN} PETSCII NOTATION FOR PETCAT -W2 TOKENIZING
2 REM BOARD DRAWN VIA DIRECT POKES TO SCREEN/COLOR RAM (NO PRINT IN HOT PATHS)
3 REM CURSOR KEYS=MOVE  SPACE=REVEAL  RETURN=FLAG  Q=QUIT
100 POKE53280,0:POKE53281,0:PRINT"{CLR}{WHT}"
110 SB=1024:CM=55296
120 DIM DR(7),DC(7),CL(8)
130 FORI=0TO7:READDR(I):NEXT
140 FORI=0TO7:READDC(I):NEXT
150 FORI=1TO8:READCL(I):NEXT
155 X9=RND(-TI)
160 GOTO300
300 PRINT"{HOME}{CLR}C64SWEEPER"
310 PRINT:PRINT"SELECT DIFFICULTY:"
320 PRINT"1 SMALL   8X8   10 MINES"
330 PRINT"2 MEDIUM 16X10  30 MINES"
340 PRINT"3 LARGE  24X14  60 MINES"
350 GETK$:IFK$=""THEN350
360 IFK$="1"THENW=8:H=8:MN=10:GOTO400
370 IFK$="2"THENW=16:H=10:MN=30:GOTO400
380 IFK$="3"THENW=24:H=14:MN=60:GOTO400
390 GOTO350
400 REM SETUP BOARD ARRAYS - ALL DIM'D ONCE PER RUN
410 NC=W*H
420 DIMVL(NC),ST(NC),RB(H),RO(H),SX(NC),SY(NC)
430 TR=2:LC=INT((40-W)/2)
440 FORR=0TOH-1
450 RB(R)=SB+(TR+R)*40+LC
460 RO(R)=CM+(TR+R)*40+LC
470 NEXTR
480 GOTO500
500 REM PLACE MINES
510 FORI=0TONC-1:VL(I)=0:ST(I)=0:NEXTI
520 PL=0
530 IFPL=MNTHEN600
540 P=INT(RND(1)*NC)
550 IFVL(P)=9THEN530
560 VL(P)=9:PL=PL+1:GOTO530
600 REM COMPUTE ADJACENT MINE COUNTS
610 FORR=0TOH-1
620 FORC=0TOW-1
630 I=R*W+C
640 IFVL(I)=9THEN700
650 A=0
660 FORN=0TO7
670 Y1=R+DR(N):X1=C+DC(N)
680 IFY1<0ORY1>H-1ORX1<0ORX1>W-1THEN695
690 J=Y1*W+X1:IFVL(J)=9THENA=A+1
695 NEXTN
696 VL(I)=A
700 NEXTC
710 NEXTR
720 FL=MN:RV=0:CX=0:CY=0:GS=0:PX=0:PY=0
730 GOTO800
800 REM DRAW FRAME AND HIDDEN BOARD (ONE-TIME FULL DRAW)
810 PRINT"{CLR}"
820 FORR=0TOH-1
830 A=RB(R):B=RO(R)
840 FORC=0TOW-1
850 POKEA+C,160:POKEB+C,11
860 NEXTC
870 NEXTR
880 PRINT"{HOME}";TAB(LC);"MINES:";MN;"  Q=QUIT"
890 R=CY:C=CX:A=RO(R):POKEA+C,14
900 GOTO1000
1000 REM MAIN LOOP
1010 GETK$:IFK$=""THEN1010
1020 IFK$="{UP}"ANDCY>0THENCY=CY-1:GOSUB1200:GOTO1010
1030 IFK$="{DOWN}"ANDCY<H-1THENCY=CY+1:GOSUB1200:GOTO1010
1040 IFK$="{LEFT}"ANDCX>0THENCX=CX-1:GOSUB1200:GOTO1010
1045 IFK$="{RIGHT}"ANDCX<W-1THENCX=CX+1:GOSUB1200:GOTO1010
1050 IFK$=" "THENGOSUB1500:GOTO1010
1055 IFK$=CHR$(13)THENGOSUB1800:GOTO1010
1060 IFK$="Q"ORK$="q"THENEND
1070 GOTO1010
1200 REM MOVE CURSOR - O(1) UPDATE: RESTORE OLD CELL, HIGHLIGHT NEW CELL
1210 R=PY:C=PX:A=RO(R):GOSUB2000
1220 R=CY:C=CX:A=RO(R):POKEA+C,14
1230 PX=CX:PY=CY
1240 RETURN
1500 REM REVEAL CELL AT CX,CY
1510 I=CY*W+CX
1520 IFST(I)<>0THENRETURN
1530 IFVL(I)=9THENGOSUB1600:GOTO1590
1540 ST(I)=1:RV=RV+1
1550 GOSUB1700
1560 IFVL(I)=0THENGOSUB1900:GOSUB1700
1570 GOSUB3000
1580 IFRV=NC-MNTHENGOSUB4000
1590 RETURN
1600 REM HIT A MINE - LOSE
1610 GS=1
1620 FORI=0TONC-1
1630 IFVL(I)=9THENST(I)=1
1640 NEXTI
1650 GOSUB1700
1660 GOSUB5000
1670 RETURN
1700 REM REDRAW WHOLE BOARD FROM STATE - SINGLE PASS, CHAR+COLOR TOGETHER
1701 REM (INLINED, NOT GOSUB2000-PER-CELL, TO AVOID GOSUB/RETURN COST IN THE LOOP)
1710 FORR=0TOH-1
1720 A=RB(R):B=RO(R)
1730 FORC=0TOW-1
1740 I=R*W+C
1750 IFST(I)=0THENPOKEA+C,160:POKEB+C,11:GOTO1790
1760 IFST(I)=2THENPOKEA+C,134:POKEB+C,7:GOTO1790
1770 IFVL(I)=9THENPOKEA+C,42:POKEB+C,2:GOTO1790
1780 IFVL(I)=0THENPOKEA+C,32:POKEB+C,12:GOTO1790
1785 POKEA+C,48+VL(I):POKEB+C,CL(VL(I))
1790 NEXTC
1795 NEXTR
1799 RETURN
1800 REM TOGGLE FLAG AT CX,CY
1802 I=CY*W+CX
1804 IFST(I)=1THENRETURN
1806 IFST(I)=2THENST(I)=0:FL=FL+1:GOTO1812
1808 IFFL=0THENRETURN
1810 ST(I)=2:FL=FL-1
1812 R=CY:C=CX:A=RO(R):GOSUB2000
1814 GOSUB3500
1816 RETURN
1900 REM ITERATIVE FLOOD FILL FROM CX,CY (ZERO CELL) - SX/SY DIM'D ONCE AT 420
1910 SP=0:SX(0)=CX:SY(0)=CY:SP=1
1920 IFSP=0THENRETURN
1930 SP=SP-1:CC=SX(SP):RR=SY(SP)
1940 FORN=0TO7
1950 Y1=RR+DR(N):X1=CC+DC(N)
1960 IFY1<0ORY1>H-1ORX1<0ORX1>W-1THEN1995
1970 J=Y1*W+X1
1980 IFST(J)<>0THEN1995
1985 ST(J)=1:RV=RV+1
1990 IFVL(J)=0THENSX(SP)=X1:SY(SP)=Y1:SP=SP+1
1995 NEXTN
1998 GOTO1920
2000 REM HELPER: SET NORMAL (NON-CURSOR) COLOR FOR CELL R,C - CALL WITH A=RO(R) SET
2010 I=R*W+C
2020 IFST(I)=2THENPOKEA+C,7:RETURN
2030 IFST(I)=0THENPOKEA+C,11:RETURN
2040 IFVL(I)=9THENPOKEA+C,2:RETURN
2050 IFVL(I)=0THENPOKEA+C,12:RETURN
2060 POKEA+C,CL(VL(I))
2070 RETURN
3000 REM SOUND: REVEAL CLICK
3010 POKE54272,0:POKE54273,20:POKE54276,17:POKE54277,0:POKE54278,248
3020 POKE54276,16
3030 RETURN
3500 REM SOUND: FLAG BEEP
3510 POKE54272,100:POKE54273,10:POKE54276,17:POKE54277,0:POKE54278,240
3520 POKE54276,16
3530 RETURN
4000 REM WIN SEQUENCE
4010 GS=2:GOSUB1700
4020 PRINT"{HOME}";TAB(LC);"{GRN}YOU WIN! ALL SAFE CELLS CLEARED."
4030 POKE54272,0:POKE54273,40:POKE54276,17:POKE54277,10:POKE54278,240:POKE54276,16
4040 GETK$:IFK$=""THEN4040
4050 RUN
5000 REM LOSE SEQUENCE
5010 PRINT"{HOME}";TAB(LC);"{RED}BOOM! GAME OVER."
5020 POKE54272,10:POKE54273,5:POKE54276,129:POKE54277,0:POKE54278,220:POKE54276,128
5030 GETK$:IFK$=""THEN5030
5040 RUN
9000 DATA-1,-1,-1,0,0,1,1,1
9010 DATA-1,0,1,-1,1,-1,0,1
9020 DATA6,5,2,4,9,3,1,12
